<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#diet-nutrition">Diet &amp; Nutrition</a> <span>›</span>
                <span>Calorie Deficit Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">📉</div>
                <div class="calc-hero-text">
                    <h1>Calorie Deficit Calculator for Fat Loss</h1>
                    <p>Calculate your target daily calorie intake, projected weight loss timeline, and safe deficit rate without metabolic slowdown.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🎯</span> Fat Loss Goal &amp; Timeline
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, ft-in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-age">Age</label>
                    <input type="number" id="inp-age" class="calc-input" value="28" min="15" max="100" oninput="calculateDeficit()">
                </div>

                <div id="metric-inputs">
                    <div class="form-group">
                        <label class="form-label" for="inp-height-cm">Height (cm)</label>
                        <input type="number" id="inp-height-cm" class="calc-input" value="175" min="100" max="230" oninput="calculateDeficit()">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-kg">Current Weight (kg)</label>
                        <input type="number" id="inp-weight-kg" class="calc-input" value="82" min="30" max="250" oninput="calculateDeficit()">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-target-kg">Goal Weight (kg)</label>
                        <input type="number" id="inp-target-kg" class="calc-input" value="72" min="30" max="250" oninput="calculateDeficit()">
                    </div>
                </div>

                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Height (ft &amp; in)</label>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                            <input type="number" id="inp-height-ft" class="calc-input" value="5" min="1" max="8" oninput="calculateDeficit()">
                            <input type="number" id="inp-height-in" class="calc-input" value="9" min="0" max="11" oninput="calculateDeficit()">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-lbs">Current Weight (lbs)</label>
                        <input type="number" id="inp-weight-lbs" class="calc-input" value="180" min="50" max="500" oninput="calculateDeficit()">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-target-lbs">Goal Weight (lbs)</label>
                        <input type="number" id="inp-target-lbs" class="calc-input" value="158" min="50" max="500" oninput="calculateDeficit()">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-activity">Activity Level</label>
                    <select id="inp-activity" class="calc-input" onchange="calculateDeficit()">
                        <option value="1.2">Sedentary (Desk job, little exercise)</option>
                        <option value="1.375" selected>Lightly Active (Workout 1-3 days/week)</option>
                        <option value="1.55">Moderately Active (Workout 3-5 days/week)</option>
                        <option value="1.725">Very Active (Heavy training 6-7 days/week)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-rate">Desired Fat Loss Pace</label>
                    <select id="inp-rate" class="calc-input" onchange="calculateDeficit()">
                        <option value="250">Mild (-0.25 kg / 0.5 lb per week - 250 kcal deficit)</option>
                        <option value="500" selected>Moderate / Recommended (-0.5 kg / 1.1 lb per week - 500 kcal deficit)</option>
                        <option value="750">Aggressive (-0.75 kg / 1.65 lb per week - 750 kcal deficit)</option>
                        <option value="1000">Extreme (-1.0 kg / 2.2 lb per week - 1,000 kcal deficit)</option>
                    </select>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Target Daily Calorie Intake</div>
                    <div class="result-main-val" id="target-cal-val">1,940 kcal/day</div>
                    <div style="margin-top:0.35rem; font-size:0.88rem; color:var(--text-secondary);">Maintenance: <strong id="maint-cal-val">2,440 kcal</strong></div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">Total Weight to Lose</div>
                        <div class="metric-item-val" id="total-loss-val">10.0 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Estimated Time to Goal</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="time-to-goal-val">20 Weeks</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="deficitChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>The 7,700 kcal Rule for 1 kg Fat Loss</h2>
            <p>
                Scientific evidence demonstrates that approximately <strong>7,700 kcal deficit</strong> results in 1 kg (2.2 lbs) of pure adipose fat loss. A daily 500 kcal deficit accumulates to a 3,500 kcal weekly deficit (~0.45-0.5 kg fat loss).
            </p>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let deficitChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateDeficit();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateDeficit();
    }

    function calculateDeficit() {
        let currentWeight, targetWeight, heightCm;

        if (currentUnit === 'metric') {
            currentWeight = parseFloat(document.getElementById('inp-weight-kg').value) || 82;
            targetWeight = parseFloat(document.getElementById('inp-target-kg').value) || 72;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 175;
        } else {
            const curLbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 180;
            const targetLbs = parseFloat(document.getElementById('inp-target-lbs').value) || 158;
            const ft = parseFloat(document.getElementById('inp-height-ft').value) || 5;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 9;
            currentWeight = curLbs * 0.45359237;
            targetWeight = targetLbs * 0.45359237;
            heightCm = (ft * 12 + inches) * 2.54;
        }

        const age = parseFloat(document.getElementById('inp-age').value) || 28;
        const activity = parseFloat(document.getElementById('inp-activity').value) || 1.375;
        const deficitAmount = parseFloat(document.getElementById('inp-rate').value) || 500;

        let bmr = (10 * currentWeight) + (6.25 * heightCm) - (5 * age);
        bmr = Math.round(gender === 'male' ? bmr + 5 : bmr - 161);

        const maintenance = Math.round(bmr * activity);
        const minSafe = gender === 'male' ? 1500 : 1200;
        const targetCalories = Math.max(minSafe, maintenance - deficitAmount);

        const weightDiffKg = Math.max(0, currentWeight - targetWeight);
        const kgPerWeek = (deficitAmount * 7) / 7700;
        const weeksNeeded = kgPerWeek > 0 ? Math.ceil(weightDiffKg / kgPerWeek) : 0;

        document.getElementById('target-cal-val').innerText = `${targetCalories.toLocaleString()} kcal/day`;
        document.getElementById('maint-cal-val').innerText = `${maintenance.toLocaleString()} kcal`;
        document.getElementById('total-loss-val').innerText = currentUnit === 'metric' ? `${weightDiffKg.toFixed(1)} kg` : `${(weightDiffKg * 2.20462).toFixed(1)} lbs`;
        document.getElementById('time-to-goal-val').innerText = `${weeksNeeded} Weeks (~${(weeksNeeded / 4.3).toFixed(1)} Months)`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('deficitChart');
            if (ctx) {
                if (deficitChart) deficitChart.destroy();
                deficitChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Target Calories (${targetCalories} kcal)`, `Daily Deficit (${deficitAmount} kcal)`],
                        datasets: [{
                            data: [targetCalories, deficitAmount],
                            backgroundColor: ['#10b981', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', size: 12 } } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateDeficit);
</script>

<%- include('partials/inner_footer') %>
