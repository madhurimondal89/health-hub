<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#diet-nutrition">Diet &amp; Nutrition</a> <span>›</span>
                <span>Protein Intake Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🥩</div>
                <div class="calc-hero-text">
                    <h1>Daily Protein Requirement Calculator</h1>
                    <p>Calculate optimal daily protein intake (grams &amp; per-meal leucine dose) for muscle growth, fat loss, or longevity based on ISSN &amp; RDA guidelines.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🥩</span> Physical Data &amp; Goal
                </div>

                <div class="form-group">
                    <label class="form-label">Units</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" id="lbl-weight" for="inp-weight">Body Weight</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-weight" class="calc-input has-suffix" value="70" min="30" max="250" oninput="calculateProtein()">
                        <span class="input-symbol-suffix" id="unit-weight">kg</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-goal">Activity Level &amp; Goal</label>
                    <select id="inp-goal" class="calc-input" onchange="calculateProtein()">
                        <option value="sedentary">Sedentary RDA Baseline (0.8 g/kg)</option>
                        <option value="active">Active Fitness / Runner (1.4 g/kg)</option>
                        <option value="muscle" selected>Hypertrophy / Muscle Building (1.8 – 2.2 g/kg)</option>
                        <option value="fat-loss">Cutting / Fat Loss Lean Preservation (2.2 – 2.6 g/kg)</option>
                        <option value="elderly">Healthy Aging &amp; Longevity (1.2 – 1.5 g/kg)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-meals">Number of Daily Meals</label>
                    <select id="inp-meals" class="calc-input" onchange="calculateProtein()">
                        <option value="3">3 Meals / Day</option>
                        <option value="4" selected>4 Meals / Day (Optimal 3-4h spacing)</option>
                        <option value="5">5 Meals / Day</option>
                    </select>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Target Daily Protein Intake</div>
                    <div class="result-main-val" id="protein-target-val">140 g/day</div>
                    <div style="margin-top:0.35rem; font-size:0.88rem; color:var(--text-secondary);">(~560 kcal from high-quality protein)</div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">Per Meal Target</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="per-meal-val">35 g / meal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Gram per kg / lb Ratio</div>
                        <div class="metric-item-val" id="ratio-val">2.0 g/kg (0.91 g/lb)</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Leucine Threshold Target</div>
                        <div class="metric-item-val" style="color:var(--accent-blue);" id="leucine-val">~3.0 g / meal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Protein Quality Standard</div>
                        <div class="metric-item-val" id="quality-val">PDCAAS 1.0</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="proteinChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>International Society of Sports Nutrition (ISSN) Recommendations</h2>
            <p>
                To stimulate maximal muscle protein synthesis (MPS), consume <strong>1.6 to 2.2 grams of protein per kilogram of body weight</strong> per day, divided across 3–4 meals containing at least 2.5–3g leucine.
            </p>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let proteinChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        const isMetric = unit === 'metric';
        document.getElementById('unit-weight').innerText = isMetric ? 'kg' : 'lbs';
        document.getElementById('inp-weight').value = isMetric ? 70 : 154;
        calculateProtein();
    }

    function calculateProtein() {
        let weightKg = parseFloat(document.getElementById('inp-weight').value) || 70;
        if (currentUnit === 'imperial') weightKg = weightKg * 0.45359237;

        const goal = document.getElementById('inp-goal').value;
        const meals = parseInt(document.getElementById('inp-meals').value) || 4;

        let multiplier = 2.0;
        if (goal === 'sedentary') multiplier = 0.8;
        else if (goal === 'active') multiplier = 1.4;
        else if (goal === 'muscle') multiplier = 2.0;
        else if (goal === 'fat-loss') multiplier = 2.3;
        else if (goal === 'elderly') multiplier = 1.3;

        const totalGrams = Math.round(weightKg * multiplier);
        const perMeal = Math.round(totalGrams / meals);

        document.getElementById('protein-target-val').innerText = `${totalGrams} g/day`;
        document.getElementById('per-meal-val').innerText = `${perMeal} g / meal`;
        document.getElementById('ratio-val').innerText = `${multiplier.toFixed(1)} g/kg (${(multiplier * 0.453592).toFixed(2)} g/lb)`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('proteinChart');
            if (ctx) {
                if (proteinChart) proteinChart.destroy();
                proteinChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: Array.from({length: meals}, (_, i) => `Meal ${i + 1}`),
                        datasets: [{
                            label: 'Protein per Meal (g)',
                            data: Array(meals).fill(perMeal),
                            backgroundColor: '#10b981',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateProtein);
</script>

<%- include('partials/inner_footer') %>
