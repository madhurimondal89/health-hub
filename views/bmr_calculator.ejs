<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#body-composition">Body Composition</a> <span>›</span>
                <span>BMR Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🔥</div>
                <div class="calc-hero-text">
                    <h1>BMR Calculator (Basal Metabolic Rate)</h1>
                    <p>Calculate the calories your body burns at complete rest using the clinically proven Mifflin-St Jeor, Harris-Benedict, and Katch-McArdle formulas.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>⚡</span> Biological Parameters
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, ft-in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-age">Age</label>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-age" class="calc-input has-suffix" value="28" min="15" max="100" oninput="syncSlider('inp-age'); calculateBMR();">
                        <span class="input-symbol-suffix">Yrs</span>
                    </div>
                    <div class="range-slider-wrap">
                        <input type="range" id="inp-age-slider" class="calc-slider" value="28" min="15" max="90" oninput="syncInput('inp-age'); calculateBMR();">
                    </div>
                </div>

                <div id="metric-inputs">
                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="inp-height-cm">Height (cm)</label>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-height-cm" class="calc-input has-suffix" value="175" min="100" max="230" step="0.5" oninput="syncSlider('inp-height-cm'); calculateBMR();">
                            <span class="input-symbol-suffix">cm</span>
                        </div>
                        <div class="range-slider-wrap">
                            <input type="range" id="inp-height-cm-slider" class="calc-slider" value="175" min="120" max="215" step="0.5" oninput="syncInput('inp-height-cm'); calculateBMR();">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="inp-weight-kg">Weight (kg)</label>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-kg" class="calc-input has-suffix" value="70" min="30" max="250" step="0.5" oninput="syncSlider('inp-weight-kg'); calculateBMR();">
                            <span class="input-symbol-suffix">kg</span>
                        </div>
                        <div class="range-slider-wrap">
                            <input type="range" id="inp-weight-kg-slider" class="calc-slider" value="70" min="35" max="160" step="0.5" oninput="syncInput('inp-weight-kg'); calculateBMR();">
                        </div>
                    </div>
                </div>

                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Height (ft &amp; in)</label>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                            <div class="input-with-symbol">
                                <input type="number" id="inp-height-ft" class="calc-input has-suffix" value="5" min="1" max="8" oninput="calculateBMR()">
                                <span class="input-symbol-suffix">ft</span>
                            </div>
                            <div class="input-with-symbol">
                                <input type="number" id="inp-height-in" class="calc-input has-suffix" value="9" min="0" max="11" oninput="calculateBMR()">
                                <span class="input-symbol-suffix">in</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="inp-weight-lbs">Weight (lbs)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-lbs" class="calc-input has-suffix" value="154" min="50" max="500" oninput="calculateBMR()">
                            <span class="input-symbol-suffix">lbs</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Basal Metabolic Rate (BMR)</div>
                    <div class="result-main-val" id="bmr-val">1,698 kcal/day</div>
                    <div style="margin-top:0.35rem; color:var(--text-secondary); font-size:0.88rem;">Calories burned at complete resting state</div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">Mifflin-St Jeor (Gold Standard)</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="mifflin-val">1,698 kcal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Revised Harris-Benedict</div>
                        <div class="metric-item-val" id="harris-val">1,732 kcal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Katch-McArdle Formula</div>
                        <div class="metric-item-val" id="katch-val">1,680 kcal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Schofield Formula (WHO)</div>
                        <div class="metric-item-val" id="schofield-val">1,710 kcal</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="bmrChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>Understanding Your Basal Metabolic Rate (BMR)</h2>
            <p>
                Your BMR represents the minimum energy expenditure required to sustain vital physiological organs (brain, heart, kidneys, lungs, liver, and cell respiration) during 24 hours of rest.
            </p>
            <div class="formula-box">
                Mifflin-St Jeor Formula:<br>
                Men: BMR = (10 × W) + (6.25 × H) - (5 × A) + 5<br>
                Women: BMR = (10 × W) + (6.25 × H) - (5 × A) - 161
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let bmrChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateBMR();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateBMR();
    }

    function syncSlider(id) {
        document.getElementById(id + '-slider').value = document.getElementById(id).value;
    }

    function syncInput(id) {
        document.getElementById(id).value = document.getElementById(id + '-slider').value;
    }

    function calculateBMR() {
        let weightKg, heightCm;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('inp-weight-kg').value) || 70;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 175;
        } else {
            const lbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 154;
            const ft = parseFloat(document.getElementById('inp-height-ft').value) || 5;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 9;
            weightKg = lbs * 0.45359237;
            heightCm = (ft * 12 + inches) * 2.54;
        }

        const age = parseFloat(document.getElementById('inp-age').value) || 28;

        // Mifflin-St Jeor
        let mifflin = (10 * weightKg) + (6.25 * heightCm) - (5 * age);
        mifflin = Math.round(gender === 'male' ? mifflin + 5 : mifflin - 161);

        // Harris-Benedict
        let harris;
        if (gender === 'male') {
            harris = Math.round(88.362 + (13.397 * weightKg) + (4.799 * heightCm) - (5.677 * age));
        } else {
            harris = Math.round(447.593 + (9.247 * weightKg) + (3.098 * heightCm) - (4.330 * age));
        }

        // Katch-McArdle estimate
        const lbm = (0.407 * weightKg) + (0.267 * heightCm) - 19.2;
        const katch = Math.round(370 + (21.6 * lbm));

        // Schofield
        const schofield = Math.round(gender === 'male' ? (15.057 * weightKg) + 692.2 : (14.818 * weightKg) + 486.6);

        document.getElementById('bmr-val').innerText = `${mifflin.toLocaleString()} kcal/day`;
        document.getElementById('mifflin-val').innerText = `${mifflin.toLocaleString()} kcal`;
        document.getElementById('harris-val').innerText = `${harris.toLocaleString()} kcal`;
        document.getElementById('katch-val').innerText = `${katch.toLocaleString()} kcal`;
        document.getElementById('schofield-val').innerText = `${schofield.toLocaleString()} kcal`;

        // Render Chart.js
        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('bmrChart');
            if (ctx) {
                if (bmrChart) bmrChart.destroy();
                bmrChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Mifflin-St Jeor', 'Harris-Benedict', 'Katch-McArdle', 'Schofield'],
                        datasets: [{
                            label: 'BMR (kcal/day)',
                            data: [mifflin, harris, katch, schofield],
                            backgroundColor: ['#10b981', '#0284c7', '#8b5cf6', '#f59e0b'],
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: false, grid: { color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateBMR);
</script>

<%- include('partials/inner_footer') %>