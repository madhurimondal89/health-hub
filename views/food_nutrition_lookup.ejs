<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#diet-nutrition">Diet &amp; Nutrition</a> <span>›</span>
                <span>Live Food Nutrition Lookup</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🍎</div>
                <div class="calc-hero-text">
                    <h1>Live Food Nutrition &amp; Calorie Lookup</h1>
                    <p>Search over 100,000+ foods, fruits, grains, and ingredients with instant live calorie, protein, carbohydrate, fat, and micronutrient breakdown via Open Food Facts.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <!-- Live Search Box -->
        <div class="input-card" style="margin-bottom: 2rem;">
            <div class="section-subtitle">
                <span>🔍</span> Search Any Food or Ingredient
            </div>

            <div style="display:flex; gap:0.75rem;">
                <input
                    type="text"
                    id="food-search-inp"
                    class="calc-input"
                    placeholder="e.g. Oatmeal, Banana, Salmon, Brown Rice, Greek Yogurt, Peanut Butter..."
                    value="Chicken Breast"
                    onkeydown="if(event.key==='Enter') searchFood()"
                >
                <button type="button" class="filter-btn active" style="padding:0 2rem; border-radius:var(--radius-md); font-size:1rem;" onclick="searchFood()">
                    Search Food
                </button>
            </div>

            <!-- Quick Preset Chips -->
            <div class="preset-chips" style="margin-top: 1rem;">
                <span style="font-size:0.85rem; color:var(--text-muted); align-self:center;">Popular:</span>
                <span class="chip" onclick="quickFood('Chicken Breast')">🍗 Chicken Breast</span>
                <span class="chip" onclick="quickFood('Eggs')">🥚 Whole Eggs</span>
                <span class="chip" onclick="quickFood('Banana')">🍌 Banana</span>
                <span class="chip" onclick="quickFood('Oatmeal')">🥣 Oatmeal</span>
                <span class="chip" onclick="quickFood('Salmon')">🐟 Salmon</span>
                <span class="chip" onclick="quickFood('Avocado')">🥑 Avocado</span>
                <span class="chip" onclick="quickFood('Almonds')">🥜 Almonds</span>
            </div>
        </div>

        <div class="calc-workspace">
            <!-- Left: Search Results List & Portion Slider -->
            <div class="input-card">
                <div class="section-subtitle">
                    <span>📋</span> Found Foods &amp; Serving Size
                </div>

                <div id="food-results-list" style="display:flex; flex-direction:column; gap:0.75rem; max-height:380px; overflow-y:auto; padding-right:0.5rem; margin-bottom:1.5rem;">
                    <div style="color:var(--text-muted); font-size:0.95rem;">Searching global nutrition database...</div>
                </div>

                <div class="form-group" id="serving-slider-group" style="border-top:1px solid var(--border-subtle); padding-top:1.25rem;">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-portion">Selected Serving Weight (Grams)</label>
                        <div class="preset-chips">
                            <span class="chip" onclick="setPortion(50)">50g</span>
                            <span class="chip" onclick="setPortion(100)">100g</span>
                            <span class="chip" onclick="setPortion(150)">150g</span>
                            <span class="chip" onclick="setPortion(200)">200g</span>
                        </div>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-portion" class="calc-input has-suffix" value="100" min="10" max="1000" step="5" oninput="updateNutrition()">
                        <span class="input-symbol-suffix">grams</span>
                    </div>
                    <div class="range-slider-wrap">
                        <input type="range" id="inp-portion-slider" class="calc-slider" value="100" min="10" max="500" step="5" oninput="document.getElementById('inp-portion').value=this.value; updateNutrition();">
                    </div>
                </div>
            </div>

            <!-- Right: Nutrition Facts Label & Macro Split -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label" id="food-name-banner">Chicken Breast (Raw / Boneless)</div>
                    <div class="result-main-val" id="food-calories-val">165 kcal</div>
                    <div style="margin-top:0.35rem; font-size:0.88rem; color:var(--text-secondary);" id="food-serving-label">Per 100g serving</div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">🍗 Protein</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="food-prot-val">31.0 g</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">🍚 Carbohydrates</div>
                        <div class="metric-item-val" style="color:var(--accent-blue);" id="food-carb-val">0.0 g</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">🥑 Total Fat</div>
                        <div class="metric-item-val" style="color:var(--accent-amber);" id="food-fat-val">3.6 g</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">🌿 Fiber / Sugar</div>
                        <div class="metric-item-val" id="food-fiber-val">0.0 g / 0.0 g</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="foodMacroChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let activeFood = { name: 'Chicken Breast', calories: 165, protein: 31.0, carbs: 0, fat: 3.6, fiber: 0, sugar: 0, sodium: 74 };
    let foodMacroChart = null;

    function quickFood(item) {
        document.getElementById('food-search-inp').value = item;
        searchFood();
    }

    function setPortion(g) {
        document.getElementById('inp-portion').value = g;
        document.getElementById('inp-portion-slider').value = g;
        updateNutrition();
    }

    async function searchFood() {
        const q = document.getElementById('food-search-inp').value.trim();
        if (!q) return;

        const listContainer = document.getElementById('food-results-list');
        listContainer.innerHTML = `<div style="color:var(--text-muted); padding:1rem 0;">Searching for "${q}"...</div>`;

        try {
            const res = await fetch(`/api/food-search?q=${encodeURIComponent(q)}`);
            const data = await res.json();

            if (!data.success || !data.results || data.results.length === 0) {
                listContainer.innerHTML = `<div style="color:var(--accent-rose); padding:1rem 0;">No items found. Try another search term.</div>`;
                return;
            }

            listContainer.innerHTML = '';
            data.results.forEach((item, idx) => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'metric-item';
                itemDiv.style.cursor = 'pointer';
                itemDiv.style.display = 'flex';
                itemDiv.style.justifyContent = 'space-between';
                itemDiv.style.alignItems = 'center';
                itemDiv.style.borderColor = idx === 0 ? 'var(--primary)' : 'var(--border-subtle)';
                itemDiv.onclick = () => selectFood(item, itemDiv);

                itemDiv.innerHTML = `
                    <div>
                        <div style="font-weight:700; color:var(--text-primary);">${item.name}</div>
                        <div style="font-size:0.78rem; color:var(--text-muted);">${item.brand} · P: ${item.protein}g · C: ${item.carbs}g · F: ${item.fat}g</div>
                    </div>
                    <div style="font-weight:800; color:var(--primary); font-family:var(--font-heading);">${item.calories} kcal</div>
                `;
                listContainer.appendChild(itemDiv);
            });

            selectFood(data.results[0], listContainer.children[0]);
        } catch (err) {
            listContainer.innerHTML = `<div style="color:var(--accent-rose); padding:1rem 0;">Network error connecting to food database.</div>`;
        }
    }

    function selectFood(item, el) {
        activeFood = item;
        const items = document.querySelectorAll('#food-results-list .metric-item');
        items.forEach(i => i.style.borderColor = 'var(--border-subtle)');
        if (el) el.style.borderColor = 'var(--primary)';
        updateNutrition();
    }

    function updateNutrition() {
        const portion = parseFloat(document.getElementById('inp-portion').value) || 100;
        const factor = portion / 100;

        const cal = Math.round(activeFood.calories * factor);
        const prot = (activeFood.protein * factor).toFixed(1);
        const carbs = (activeFood.carbs * factor).toFixed(1);
        const fat = (activeFood.fat * factor).toFixed(1);
        const fiber = (activeFood.fiber * factor).toFixed(1);
        const sugar = (activeFood.sugar * factor).toFixed(1);

        document.getElementById('food-name-banner').innerText = activeFood.name;
        document.getElementById('food-calories-val').innerText = `${cal} kcal`;
        document.getElementById('food-serving-label').innerText = `Per ${portion}g portion size`;
        document.getElementById('food-prot-val').innerText = `${prot} g`;
        document.getElementById('food-carb-val').innerText = `${carbs} g`;
        document.getElementById('food-fat-val').innerText = `${fat} g`;
        document.getElementById('food-fiber-val').innerText = `${fiber} g / ${sugar} g`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('foodMacroChart');
            if (ctx) {
                if (foodMacroChart) foodMacroChart.destroy();
                foodMacroChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Protein (${prot}g)`, `Carbohydrates (${carbs}g)`, `Healthy Fats (${fat}g)`],
                        datasets: [{
                            data: [parseFloat(prot) * 4, parseFloat(carbs) * 4, parseFloat(fat) * 9],
                            backgroundColor: ['#10b981', '#0284c7', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', searchFood);
</script>

<%- include('partials/inner_footer') %>
