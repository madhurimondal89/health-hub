<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#sleep-wellness">Sleep &amp; Wellness</a> <span>›</span>
                <span>Sleep Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">😴</div>
                <div class="calc-hero-text">
                    <h1>Sleep Cycle &amp; Circadian Optimizer</h1>
                    <p>Calculate the best time to fall asleep or wake up based on natural 90-minute REM &amp; NREM sleep cycles to wake up energized.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🌙</span> Sleep Schedule Mode
                </div>

                <div class="form-group">
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-wake-mode" class="toggle-pill-btn active" style="flex:1;" onclick="setMode('wake')">⏰ I want to wake up at...</button>
                        <button type="button" id="btn-sleep-mode" class="toggle-pill-btn" style="flex:1;" onclick="setMode('sleep')">🛌 If I go to sleep now...</button>
                    </div>
                </div>

                <div id="wake-time-section" class="form-group">
                    <label class="form-label" for="wake-time">Target Wake-Up Time</label>
                    <input type="time" id="wake-time" class="calc-input" value="07:00" onchange="calculateSleep()">
                </div>

                <div class="form-group">
                    <label class="form-label">Average Time to Fall Asleep</label>
                    <div class="preset-chips">
                        <span class="chip" onclick="setLatency(10)">10 min</span>
                        <span class="chip" onclick="setLatency(15)">15 min (Avg)</span>
                        <span class="chip" onclick="setLatency(20)">20 min</span>
                        <span class="chip" onclick="setLatency(30)">30 min</span>
                    </div>
                    <div class="input-with-symbol" style="margin-top:0.5rem;">
                        <input type="number" id="inp-latency" class="calc-input has-suffix" value="15" min="0" max="60" oninput="calculateSleep()">
                        <span class="input-symbol-suffix">min</span>
                    </div>
                </div>
            </div>

            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label" id="sleep-res-label">Suggested Bedtimes</div>
                    <div class="result-main-val" id="sleep-prime-time" style="font-size:2.4rem;">10:00 PM or 11:30 PM</div>
                    <div style="margin-top:0.35rem; font-size:0.88rem; color:var(--text-secondary);">Completes 5 to 6 full 90-minute sleep cycles</div>
                </div>

                <div class="section-subtitle" style="font-size:1rem; margin-bottom:0.75rem;">Optimal 90-Min Sleep Cycle Options</div>
                
                <div id="sleep-cards-container" style="display:flex; flex-direction:column; gap:0.65rem;">
                    <!-- Dynamic Sleep Cycle Cards Generated via JS -->
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>The Science of 90-Minute Sleep Cycles</h2>
            <p>
                A standard human sleep cycle lasts approximately <strong>90 minutes</strong>, cycling through Light Sleep (NREM Stage 1 &amp; 2), Deep Slow-Wave Sleep (NREM Stage 3), and Rapid Eye Movement (REM) dream sleep.
            </p>
            <p>
                Waking up in the middle of Deep Sleep leaves you feeling groggy (sleep inertia), whereas waking at the end of a completed 90-minute cycle ensures you feel fresh and alert.
            </p>
        </section>
    </div>
</main>

<script>
    let currentMode = 'wake';

    function setMode(m) {
        currentMode = m;
        document.getElementById('btn-wake-mode').classList.toggle('active', m === 'wake');
        document.getElementById('btn-sleep-mode').classList.toggle('active', m === 'sleep');
        document.getElementById('wake-time-section').style.display = m === 'wake' ? 'block' : 'none';
        calculateSleep();
    }

    function setLatency(l) {
        document.getElementById('inp-latency').value = l;
        calculateSleep();
    }

    function formatTime(d) {
        let hours = d.getHours();
        let minutes = d.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        return `${hours}:${minutes} ${ampm}`;
    }

    function calculateSleep() {
        const latency = parseInt(document.getElementById('inp-latency').value) || 15;
        const container = document.getElementById('sleep-cards-container');
        container.innerHTML = '';

        if (currentMode === 'wake') {
            const timeStr = document.getElementById('wake-time').value || '07:00';
            const [wH, wM] = timeStr.split(':').map(Number);
            const wakeDate = new Date();
            wakeDate.setHours(wH, wM, 0, 0);

            document.getElementById('sleep-res-label').innerText = 'To Wake Up at ' + formatTime(wakeDate) + ', go to bed at:';

            // Cycles: 6 cycles (9 hrs), 5 cycles (7.5 hrs), 4 cycles (6 hrs)
            const cycles = [
                { count: 6, hours: 9, note: 'Recommended (Optimal 9 hrs)', color: '#10b981' },
                { count: 5, hours: 7.5, note: 'Great (7.5 hrs rest)', color: '#0284c7' },
                { count: 4, hours: 6, note: 'Minimum (6 hrs rest)', color: '#f59e0b' }
            ];

            cycles.forEach((c, idx) => {
                const bedDate = new Date(wakeDate.getTime() - (c.hours * 60 * 60 * 1000) - (latency * 60 * 1000));
                const timeText = formatTime(bedDate);
                if (idx === 0) document.getElementById('sleep-prime-time').innerText = timeText;

                const div = document.createElement('div');
                div.className = 'metric-item';
                div.style.display = 'flex';
                div.style.justifyContent = 'space-between';
                div.style.alignItems = 'center';
                div.innerHTML = `
                    <div>
                        <div style="font-weight:700; color:${c.color};">${c.count} Sleep Cycles (${c.hours} hrs)</div>
                        <div style="font-size:0.78rem; color:var(--text-muted);">${c.note}</div>
                    </div>
                    <div class="metric-item-val" style="font-size:1.3rem; color:${c.color};">${timeText}</div>
                `;
                container.appendChild(div);
            });
        } else {
            const now = new Date();
            document.getElementById('sleep-res-label').innerText = 'If you sleep right now, wake up at:';

            const cycles = [
                { count: 6, hours: 9, note: '6 Complete Cycles (9 hrs)', color: '#10b981' },
                { count: 5, hours: 7.5, note: '5 Complete Cycles (7.5 hrs)', color: '#0284c7' },
                { count: 4, hours: 6, note: '4 Complete Cycles (6 hrs)', color: '#f59e0b' }
            ];

            cycles.forEach((c, idx) => {
                const wakeDate = new Date(now.getTime() + (c.hours * 60 * 60 * 1000) + (latency * 60 * 1000));
                const timeText = formatTime(wakeDate);
                if (idx === 1) document.getElementById('sleep-prime-time').innerText = timeText;

                const div = document.createElement('div');
                div.className = 'metric-item';
                div.style.display = 'flex';
                div.style.justifyContent = 'space-between';
                div.style.alignItems = 'center';
                div.innerHTML = `
                    <div>
                        <div style="font-weight:700; color:${c.color};">${c.count} Cycles (${c.hours} hrs)</div>
                        <div style="font-size:0.78rem; color:var(--text-muted);">${c.note}</div>
                    </div>
                    <div class="metric-item-val" style="font-size:1.3rem; color:${c.color};">${timeText}</div>
                `;
                container.appendChild(div);
            });
        }
    }

    document.addEventListener('DOMContentLoaded', calculateSleep);
</script>

<%- include('partials/inner_footer') %>