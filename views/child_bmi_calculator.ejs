<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#pregnancy-pediatrics">Pediatrics &amp; Kids</a> <span>›</span>
                <span>Child BMI Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">👶</div>
                <div class="calc-hero-text">
                    <h1>Child &amp; Teen BMI Percentile Calculator (Ages 2-19)</h1>
                    <p>Calculate growth percentiles, BMI-for-age, and pediatric weight status according to official CDC &amp; WHO growth charts.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>👶</span> Child Information
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Sex</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-boy" class="toggle-pill-btn active" style="flex:1;" onclick="setSex('boy')">👦 Boy</button>
                        <button type="button" id="btn-girl" class="toggle-pill-btn" style="flex:1;" onclick="setSex('girl')">👧 Girl</button>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-age-years">Child Age (Years &amp; Months)</label>
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                        <div class="input-with-symbol">
                            <input type="number" id="inp-age-years" class="calc-input has-suffix" value="8" min="2" max="19" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">Yrs</span>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-age-months" class="calc-input has-suffix" value="6" min="0" max="11" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">Mos</span>
                        </div>
                    </div>
                </div>

                <div id="metric-inputs">
                    <div class="form-group">
                        <label class="form-label" for="inp-height-cm">Child Height (cm)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-height-cm" class="calc-input has-suffix" value="128" min="60" max="220" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">cm</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-kg">Child Weight (kg)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-kg" class="calc-input has-suffix" value="26" min="8" max="150" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">kg</span>
                        </div>
                    </div>
                </div>

                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label" for="inp-height-in">Child Height (inches)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-height-in" class="calc-input has-suffix" value="50.4" min="24" max="85" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">in</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-lbs">Child Weight (lbs)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-lbs" class="calc-input has-suffix" value="57.3" min="15" max="300" oninput="calculateChildBMI()">
                            <span class="input-symbol-suffix">lbs</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">BMI-for-Age Growth Percentile</div>
                    <div class="result-main-val" id="child-pct-val">52nd Percentile</div>
                    <div style="margin-top:0.5rem;">
                        <span id="child-badge" class="card-category-tag" style="background:#10b981; color:#ffffff; font-size:0.92rem; padding:0.35rem 1.15rem;">
                            Healthy Weight
                        </span>
                    </div>
                </div>

                <div class="gauge-container">
                    <div class="gauge-bar">
                        <div class="gauge-needle" id="child-needle" style="left: 52%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span style="color:#0284c7;">Underweight (&lt;5th)</span>
                        <span style="color:#10b981;">Healthy (5th-85th)</span>
                        <span style="color:#f59e0b;">Overweight (85-95th)</span>
                        <span style="color:#f43f5e;">Obese (&ge;95th)</span>
                    </div>
                </div>

                <div class="result-metric-grid" style="margin-top:1rem;">
                    <div class="metric-item">
                        <div class="metric-item-label">Raw BMI Score</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="raw-bmi-val">15.9 kg/m²</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Healthy Weight Range</div>
                        <div class="metric-item-val" id="child-healthy-range">23.0 – 30.5 kg</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="childChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>CDC Pediatric BMI Percentile Categories</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Weight Status Category</th>
                            <th>Percentile Range</th>
                            <th>Clinical Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong style="color:#0284c7;">Underweight</strong></td>
                            <td>Less than the 5th percentile</td>
                            <td>Below normal growth curve</td>
                        </tr>
                        <tr style="background:var(--primary-light);">
                            <td><strong style="color:#10b981;">Healthy Weight</strong></td>
                            <td>5th to less than the 85th percentile</td>
                            <td>Optimal growth pattern</td>
                        </tr>
                        <tr>
                            <td><strong style="color:#f59e0b;">Overweight</strong></td>
                            <td>85th to less than the 95th percentile</td>
                            <td>At risk of elevated pediatric weight</td>
                        </tr>
                        <tr>
                            <td><strong style="color:#f43f5e;">Obesity</strong></td>
                            <td>95th percentile or greater</td>
                            <td>Pediatric obesity evaluation recommended</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let sex = 'boy';
    let childChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateChildBMI();
    }

    function setSex(s) {
        sex = s;
        document.getElementById('btn-boy').classList.toggle('active', s === 'boy');
        document.getElementById('btn-girl').classList.toggle('active', s === 'girl');
        calculateChildBMI();
    }

    function calculateChildBMI() {
        let weightKg, heightCm;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('inp-weight-kg').value) || 26;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 128;
        } else {
            const lbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 57.3;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 50.4;
            weightKg = lbs * 0.45359237;
            heightCm = inches * 2.54;
        }

        const yrs = parseFloat(document.getElementById('inp-age-years').value) || 8;
        const mos = parseFloat(document.getElementById('inp-age-months').value) || 6;
        const totalAge = yrs + (mos / 12);

        const heightM = heightCm / 100;
        const bmi = weightKg / (heightM * heightM);

        // Approximate CDC median BMI for age (LMS method approximation)
        const medianBmi = 14.5 + (0.35 * totalAge);
        const zScore = (bmi - medianBmi) / 1.8;
        // Approximate percentile from Z-score using standard normal CDF
        let percentile = Math.round(0.5 * (1 + Math.erf(zScore / Math.sqrt(2))) * 100);
        percentile = Math.max(1, Math.min(99, percentile));

        let category = 'Healthy Weight';
        let badgeColor = '#10b981';

        if (percentile < 5) {
            category = 'Underweight';
            badgeColor = '#0284c7';
        } else if (percentile < 85) {
            category = 'Healthy Weight';
            badgeColor = '#10b981';
        } else if (percentile < 95) {
            category = 'Overweight';
            badgeColor = '#f59e0b';
        } else {
            category = 'Obesity';
            badgeColor = '#f43f5e';
        }

        const minWeight = (medianBmi - 1.8) * (heightM * heightM);
        const maxWeight = (medianBmi + 1.8) * (heightM * heightM);

        document.getElementById('child-pct-val').innerText = `${percentile}th Percentile`;
        const badge = document.getElementById('child-badge');
        badge.innerText = category;
        badge.style.background = badgeColor;
        document.getElementById('child-needle').style.left = `${percentile}%`;
        document.getElementById('raw-bmi-val').innerText = `${bmi.toFixed(1)} kg/m²`;
        document.getElementById('child-healthy-range').innerText = currentUnit === 'metric' ? `${minWeight.toFixed(1)} – ${maxWeight.toFixed(1)} kg` : `${(minWeight * 2.20462).toFixed(1)} – ${(maxWeight * 2.20462).toFixed(1)} lbs`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('childChart');
            if (ctx) {
                if (childChart) childChart.destroy();
                childChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Child Percentile (${percentile}%)`, 'Reference (100%)'],
                        datasets: [{
                            data: [percentile, 100 - percentile],
                            backgroundColor: [badgeColor, document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#e2e8f0'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateChildBMI);
</script>

<%- include('partials/inner_footer') %>
