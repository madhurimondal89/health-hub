<%- include('partials/inner_header') %>

<div class="container">
    <div class="calculator-container">
        <h1 class="calculator-title"><%= title %></h1>
<%- include('partials/ad_unit') %>

        <div class="unit-switcher">
            <button id="metricBtn" class="unit-btn active">Metric (kg, cm)</button>
            <button id="imperialBtn" class="unit-btn">Imperial (lbs, ft, in)</button>
        </div>

        <div class="calculator-grid">
            <div class="form-section">
                <form id="childBmiForm">
                    <div class="form-group">
                        <label for="childAge">Child's Age (years, 2–19)</label>
                        <div class="input-wrapper"><input type="number" id="childAge" min="2" max="19" placeholder="e.g., 10"></div>
                    </div>
                    <div class="form-group">
                        <label for="childGender">Gender</label>
                        <div class="input-wrapper">
                            <select id="childGender">
                                <option value="boy">Boy</option>
                                <option value="girl">Girl</option>
                            </select>
                        </div>
                    </div>

                    <!-- Metric Inputs -->
                    <div id="metricInputs">
                        <div class="form-group">
                            <label for="weightKg">Weight (kg)</label>
                            <div class="input-wrapper"><input type="number" id="weightKg" step="0.1" placeholder="e.g., 35"></div>
                        </div>
                        <div class="form-group">
                            <label for="heightCm">Height (cm)</label>
                            <div class="input-wrapper"><input type="number" id="heightCm" step="0.5" placeholder="e.g., 140"></div>
                        </div>
                    </div>

                    <!-- Imperial Inputs -->
                    <div id="imperialInputs" style="display:none;">
                        <div class="form-group">
                            <label for="weightLbs">Weight (lbs)</label>
                            <div class="input-wrapper"><input type="number" id="weightLbs" step="0.1" placeholder="e.g., 77"></div>
                        </div>
                        <div class="form-group">
                            <label>Height (ft, in)</label>
                            <div class="height-imperial-inputs">
                                <div class="input-wrapper"><input type="number" id="heightFt" placeholder="e.g., 4"><span class="input-adornment">ft</span></div>
                                <div class="input-wrapper"><input type="number" id="heightIn" placeholder="e.g., 7"><span class="input-adornment">in</span></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="result-section" id="result-section">
                <div class="placeholder">Select units and enter your child's details to calculate BMI.</div>
            </div>
        </div>

        <div class="faq-section">
            <div class="accordion-item"><button class="accordion-header"><span>Is BMI accurate for children?</span><span class="icon">+</span></button><div class="accordion-content"><p>Child BMI (BMI-for-age) accounts for age and gender differences in body fat, making it more appropriate than adult BMI for growing children. However, BMI is a screening tool — it does not directly measure body fat. A healthcare provider should perform a full assessment.</p></div></div>
            <div class="accordion-item"><button class="accordion-header"><span>What is a healthy BMI for a child?</span><span class="icon">+</span></button><div class="accordion-content"><p>According to the CDC, a healthy weight for children is between the <strong>5th and 85th percentile</strong> for their age and gender. Below the 5th percentile is considered underweight, while at or above the 95th percentile is considered obese.</p></div></div>
            <div class="accordion-item"><button class="accordion-header"><span>My child is overweight — what should I do?</span><span class="icon">+</span></button><div class="accordion-content"><p>Consult your pediatrician before making any dietary changes. For growing children, the focus should be on <strong>healthy habits</strong> — balanced nutrition, regular physical activity, and adequate sleep — rather than weight loss, which can interfere with normal development.</p></div></div>
        </div>

<%- include('partials/ad_unit') %>

        <div style="margin-top:2rem;padding:1.5rem;background:var(--card-bg);border-radius:12px;border:1px solid var(--border-color);">
            <h3 style="margin:0 0 1rem;font-size:1rem;color:var(--text-muted);">🔗 Related Calculators</h3>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                <a href="/bmi-calculator" style="padding:0.4rem 0.9rem;background:var(--accent-gradient);color:#fff;border-radius:20px;font-size:0.85rem;text-decoration:none;">⚖️ Adult BMI</a>
                <a href="/ideal-weight-calculator" style="padding:0.4rem 0.9rem;background:var(--accent-gradient);color:#fff;border-radius:20px;font-size:0.85rem;text-decoration:none;">🎯 Ideal Weight</a>
                <a href="/calorie-calculator" style="padding:0.4rem 0.9rem;background:var(--accent-gradient);color:#fff;border-radius:20px;font-size:0.85rem;text-decoration:none;">🍽️ Calorie Calculator</a>
                <a href="/water-intake-calculator" style="padding:0.4rem 0.9rem;background:var(--accent-gradient);color:#fff;border-radius:20px;font-size:0.85rem;text-decoration:none;">💧 Water Intake</a>
            </div>
        </div>
    </div>
</div>

<script>
    let currentUnit = 'metric';
    const resultDiv = document.getElementById('result-section');
    const metricBtn = document.getElementById('metricBtn');
    const imperialBtn = document.getElementById('imperialBtn');
    const metricInputsDiv = document.getElementById('metricInputs');
    const imperialInputsDiv = document.getElementById('imperialInputs');

    function switchUnit(unit) {
        currentUnit = unit;
        metricBtn.classList.toggle('active', unit === 'metric');
        imperialBtn.classList.toggle('active', unit === 'imperial');
        metricInputsDiv.style.display = unit === 'metric' ? 'block' : 'none';
        imperialInputsDiv.style.display = unit === 'imperial' ? 'block' : 'none';
        document.querySelectorAll('input[type="number"]').forEach(i => i.value = '');
        resultDiv.innerHTML = `<div class="placeholder">Enter your child's details to calculate.</div>`;
    }
    metricBtn.addEventListener('click', () => switchUnit('metric'));
    imperialBtn.addEventListener('click', () => switchUnit('imperial'));

    // CDC approximate BMI percentile thresholds by age for boys/girls
    // Source: CDC BMI-for-age charts (simplified thresholds for 5th, 85th, 95th percentiles)
    // Values are approximate midpoints; keys are ages 2-19
    const cdcThresholds = {
        boy: {
            2:  { p5: 14.5, p85: 17.5, p95: 18.4 },
            3:  { p5: 13.9, p85: 17.0, p95: 18.1 },
            4:  { p5: 13.4, p85: 16.7, p95: 17.8 },
            5:  { p5: 13.2, p85: 16.7, p95: 18.0 },
            6:  { p5: 13.1, p85: 16.9, p95: 18.4 },
            7:  { p5: 13.1, p85: 17.3, p95: 19.1 },
            8:  { p5: 13.2, p85: 17.9, p95: 19.9 },
            9:  { p5: 13.4, p85: 18.6, p95: 20.8 },
            10: { p5: 13.7, p85: 19.4, p95: 21.8 },
            11: { p5: 14.0, p85: 20.2, p95: 22.8 },
            12: { p5: 14.4, p85: 21.0, p95: 23.7 },
            13: { p5: 14.8, p85: 21.8, p95: 24.6 },
            14: { p5: 15.3, p85: 22.5, p95: 25.4 },
            15: { p5: 15.8, p85: 23.2, p95: 26.1 },
            16: { p5: 16.3, p85: 23.8, p95: 26.7 },
            17: { p5: 16.7, p85: 24.2, p95: 27.1 },
            18: { p5: 17.1, p85: 24.6, p95: 27.6 },
            19: { p5: 17.5, p85: 25.0, p95: 28.0 },
        },
        girl: {
            2:  { p5: 14.1, p85: 17.1, p95: 18.0 },
            3:  { p5: 13.5, p85: 16.7, p95: 17.6 },
            4:  { p5: 13.1, p85: 16.6, p95: 17.5 },
            5:  { p5: 12.9, p85: 16.7, p95: 17.8 },
            6:  { p5: 12.8, p85: 17.0, p95: 18.3 },
            7:  { p5: 12.9, p85: 17.6, p95: 19.2 },
            8:  { p5: 13.1, p85: 18.3, p95: 20.2 },
            9:  { p5: 13.4, p85: 19.1, p95: 21.3 },
            10: { p5: 13.7, p85: 19.9, p95: 22.3 },
            11: { p5: 14.1, p85: 20.7, p95: 23.2 },
            12: { p5: 14.6, p85: 21.5, p95: 24.1 },
            13: { p5: 15.1, p85: 22.2, p95: 24.9 },
            14: { p5: 15.6, p85: 22.8, p95: 25.6 },
            15: { p5: 16.1, p85: 23.4, p95: 26.2 },
            16: { p5: 16.5, p85: 23.9, p95: 26.7 },
            17: { p5: 16.8, p85: 24.3, p95: 27.2 },
            18: { p5: 17.2, p85: 24.7, p95: 27.6 },
            19: { p5: 17.5, p85: 25.0, p95: 28.0 },
        }
    };

    function calculateChildBMI() {
        const age = parseInt(document.getElementById('childAge').value);
        const gender = document.getElementById('childGender').value;
        let weightKg, heightM;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('weightKg').value);
            const heightCm = parseFloat(document.getElementById('heightCm').value);
            heightM = isNaN(heightCm) ? NaN : heightCm / 100;
        } else {
            const lbs = parseFloat(document.getElementById('weightLbs').value);
            const ft = parseFloat(document.getElementById('heightFt').value);
            const inches = parseFloat(document.getElementById('heightIn').value) || 0;
            weightKg = isNaN(lbs) ? NaN : lbs * 0.453592;
            heightM = isNaN(ft) ? NaN : ((ft * 12 + inches) * 2.54) / 100;
        }

        if (isNaN(age) || age < 2 || age > 19) {
            resultDiv.innerHTML = `<div class="placeholder">Please enter a valid age between 2 and 19.</div>`; return;
        }
        if (isNaN(weightKg) || isNaN(heightM) || weightKg <= 0 || heightM <= 0) {
            resultDiv.innerHTML = `<div class="placeholder">Please enter valid weight and height.</div>`; return;
        }

        const bmi = weightKg / (heightM * heightM);
        const bmiStr = bmi.toFixed(1);
        const genderKey = gender === 'girl' ? 'girl' : 'boy';
        const thresholds = cdcThresholds[genderKey][age] || cdcThresholds[genderKey][Math.min(19, Math.max(2, age))];

        let category, categoryColor, percentileRange;
        if (bmi < thresholds.p5) {
            category = 'Underweight'; categoryColor = '#3b82f6'; percentileRange = 'Below 5th percentile';
        } else if (bmi < thresholds.p85) {
            category = 'Healthy Weight'; categoryColor = '#22c55e'; percentileRange = '5th to < 85th percentile';
        } else if (bmi < thresholds.p95) {
            category = 'Overweight'; categoryColor = '#f59e0b'; percentileRange = '85th to < 95th percentile';
        } else {
            category = 'Obese'; categoryColor = '#ef4444'; percentileRange = '95th percentile or above';
        }

        resultDiv.innerHTML = `
            <div class="result-display-new">
                <p class="result-main-text">BMI: <strong>${bmiStr}</strong></p>
                <hr class="result-divider" />
                <p class="result-sub-text">Category: <strong style="color:${categoryColor}">${category}</strong></p>
            </div>
            <div style="margin-top:1rem;padding:0.85rem 1rem;background:var(--card-bg);border-radius:8px;border:1px solid var(--border-color);font-size:0.85rem;line-height:1.7;">
                <div>📊 Approximate Percentile Range: <strong>${percentileRange}</strong></div>
                <div style="margin-top:0.5rem;font-size:0.8rem;color:var(--text-muted);">Based on CDC BMI-for-age charts (age ${age}, ${gender})</div>
            </div>
            <div style="margin-top:1rem;padding:0.85rem 1rem;background:#fef3c7;border-radius:8px;border:1px solid #f59e0b;font-size:0.82rem;color:#78350f;line-height:1.6;">
                ⚠️ <strong>Disclaimer:</strong> These values are approximations based on CDC reference data. BMI-for-age is a screening tool, not a diagnostic test. Please consult a qualified pediatrician for an accurate assessment of your child's growth and health.
            </div>
        `;
    }

    document.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('input', calculateChildBMI);
        el.addEventListener('change', calculateChildBMI);
    });

    document.querySelectorAll('.accordion-header').forEach(header => {
        header.addEventListener('click', () => {
            const accordionItem = header.parentElement;
            accordionItem.classList.toggle('active');
            const content = header.nextElementSibling;
            content.style.maxHeight = accordionItem.classList.contains('active') ? content.scrollHeight + 'px' : '0px';
        });
    });
</script>

<%- include('partials/inner_footer') %>
