<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#hydration-lifestyle">Hydration &amp; Vitals</a> <span>›</span>
                <span>Water Intake Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">💧</div>
                <div class="calc-hero-text">
                    <h1>Daily Water Intake &amp; Hydration Calculator</h1>
                    <p>Calculate your daily water requirement based on body weight, workout intensity, climate temperature, and hydration goals.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>💧</span> Hydration Parameters
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, ml, °C)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, fl oz, °F)</button>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" id="lbl-weight" for="inp-weight">Body Weight</label>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-weight" class="calc-input has-suffix" value="70" step="0.5" oninput="syncSlider('inp-weight'); calculateWater();">
                        <span class="input-symbol-suffix" id="unit-weight">kg</span>
                    </div>
                    <div class="range-slider-wrap">
                        <input type="range" id="inp-weight-slider" class="calc-slider" value="70" min="30" max="160" step="0.5" oninput="syncInput('inp-weight'); calculateWater();">
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-exercise">Daily Exercise Duration</label>
                        <div class="preset-chips">
                            <span class="chip" onclick="setExercise(0)">None</span>
                            <span class="chip" onclick="setExercise(30)">30 min</span>
                            <span class="chip" onclick="setExercise(60)">60 min</span>
                            <span class="chip" onclick="setExercise(90)">90 min</span>
                        </div>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-exercise" class="calc-input has-suffix" value="45" min="0" max="240" oninput="syncSlider('inp-exercise'); calculateWater();">
                        <span class="input-symbol-suffix">min</span>
                    </div>
                    <div class="range-slider-wrap">
                        <input type="range" id="inp-exercise-slider" class="calc-slider" value="45" min="0" max="180" oninput="syncInput('inp-exercise'); calculateWater();">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-climate">Climate / Environment</label>
                    <select id="inp-climate" class="calc-input" onchange="calculateWater()">
                        <option value="1.0">Moderate / Normal (20°C / 68°F)</option>
                        <option value="1.15" selected>Warm / Summer Climate (28°C / 82°F)</option>
                        <option value="1.3">Hot / Humid &amp; Sunny (35°C+ / 95°F)</option>
                        <option value="0.95">Cold / Winter Climate</option>
                    </select>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Target Daily Water Intake</div>
                    <div class="result-main-val" id="water-main-val">2.8 Liters/day</div>
                    <div style="margin-top:0.5rem;">
                        <span id="water-glasses-val" class="card-category-tag" style="background:#0284c7; color:#ffffff; font-size:0.92rem; padding:0.35rem 1.15rem;">
                            ~ 11 Standard Glasses (250ml)
                        </span>
                    </div>
                </div>

                <div class="gauge-container">
                    <div class="gauge-bar">
                        <div class="gauge-needle" id="water-needle" style="left: 60%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span style="color:#0284c7;">Light (1.5L)</span>
                        <span style="color:#10b981;">Optimal (2.5L)</span>
                        <span style="color:#06b6d4;">Active (3.5L)</span>
                        <span style="color:#3b82f6;">Athletic (4.5L+)</span>
                    </div>
                </div>

                <div class="result-metric-grid" style="margin-top:1rem;">
                    <div class="metric-item">
                        <div class="metric-item-label">Hourly Sip Target</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="hourly-target-val">175 ml/hr</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Workout Electrolyte Fluid</div>
                        <div class="metric-item-val" id="workout-fluid-val">525 ml</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="waterChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>Scientific Hydration Guidelines (WHO &amp; EFSA)</h2>
            <p>
                Adequate hydration maintains cardiovascular efficiency, prevents muscle cramps, lubricates joints, aids digestion, and optimizes brain cognition.
            </p>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let waterChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        const isMetric = unit === 'metric';
        document.getElementById('unit-weight').innerText = isMetric ? 'kg' : 'lbs';
        document.getElementById('inp-weight').value = isMetric ? 70 : 154;
        document.getElementById('inp-weight-slider').value = isMetric ? 70 : 154;
        document.getElementById('inp-weight-slider').max = isMetric ? 160 : 350;
        calculateWater();
    }

    function setExercise(e) {
        document.getElementById('inp-exercise').value = e;
        document.getElementById('inp-exercise-slider').value = e;
        calculateWater();
    }

    function syncSlider(id) {
        document.getElementById(id + '-slider').value = document.getElementById(id).value;
    }

    function syncInput(id) {
        document.getElementById(id).value = document.getElementById(id + '-slider').value;
    }

    function calculateWater() {
        let weightKg = parseFloat(document.getElementById('inp-weight').value) || 70;
        if (currentUnit === 'imperial') weightKg = weightKg * 0.45359237;

        const exerciseMin = parseFloat(document.getElementById('inp-exercise').value) || 0;
        const climateMod = parseFloat(document.getElementById('inp-climate').value) || 1.15;

        // Baseline: 35 ml per kg + (exerciseMin / 30 * 350 ml) * climate
        const baselineMl = weightKg * 35;
        const exerciseMl = (exerciseMin / 30) * 350;
        const totalMl = Math.round((baselineMl + exerciseMl) * climateMod);
        const liters = (totalMl / 1000).toFixed(1);
        const flOz = Math.round(totalMl * 0.033814);
        const glasses = Math.round(totalMl / 250);

        const hourlyMl = Math.round(totalMl / 16); // 16 waking hours

        if (currentUnit === 'metric') {
            document.getElementById('water-main-val').innerText = `${liters} Liters/day`;
            document.getElementById('hourly-target-val').innerText = `${hourlyMl} ml/hr`;
            document.getElementById('workout-fluid-val').innerText = `${Math.round(exerciseMl)} ml`;
        } else {
            document.getElementById('water-main-val').innerText = `${flOz} fl oz/day`;
            document.getElementById('hourly-target-val').innerText = `${Math.round(hourlyMl * 0.033814)} fl oz/hr`;
            document.getElementById('workout-fluid-val').innerText = `${Math.round(exerciseMl * 0.033814)} fl oz`;
        }

        document.getElementById('water-glasses-val').innerText = `~ ${glasses} Standard Glasses (${currentUnit === 'metric' ? '250ml' : '8 fl oz'})`;
        const needlePct = Math.min(95, Math.max(10, (totalMl / 4500) * 100));
        document.getElementById('water-needle').style.left = `${needlePct}%`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('waterChart');
            if (ctx) {
                if (waterChart) waterChart.destroy();
                waterChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Baseline Need (${Math.round(baselineMl)} ml)`, `Workout Hydration (${Math.round(exerciseMl * climateMod)} ml)`],
                        datasets: [{
                            data: [baselineMl, Math.max(100, exerciseMl * climateMod)],
                            backgroundColor: ['#0284c7', '#10b981'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateWater);
</script>

<%- include('partials/inner_footer') %>