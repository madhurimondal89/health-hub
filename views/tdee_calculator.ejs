<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#body-composition">Body Composition</a> <span>›</span>
                <span>TDEE Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">⚡</div>
                <div class="calc-hero-text">
                    <h1>TDEE Calculator (Total Daily Energy Expenditure)</h1>
                    <p>Calculate your daily maintenance calories, macronutrient targets, and total energy expenditure based on activity level.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>⚡</span> Energy Parameters
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, ft-in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-age">Age</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-age" class="calc-input has-suffix" value="28" min="15" max="100" oninput="calculateTDEE()">
                        <span class="input-symbol-suffix">Yrs</span>
                    </div>
                </div>

                <div id="metric-inputs">
                    <div class="form-group">
                        <label class="form-label" for="inp-height-cm">Height (cm)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-height-cm" class="calc-input has-suffix" value="175" min="100" max="230" oninput="calculateTDEE()">
                            <span class="input-symbol-suffix">cm</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-kg">Weight (kg)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-kg" class="calc-input has-suffix" value="70" min="30" max="250" oninput="calculateTDEE()">
                            <span class="input-symbol-suffix">kg</span>
                        </div>
                    </div>
                </div>

                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Height (ft &amp; in)</label>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                            <input type="number" id="inp-height-ft" class="calc-input" value="5" min="1" max="8" oninput="calculateTDEE()">
                            <input type="number" id="inp-height-in" class="calc-input" value="9" min="0" max="11" oninput="calculateTDEE()">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-lbs">Weight (lbs)</label>
                        <input type="number" id="inp-weight-lbs" class="calc-input" value="154" min="50" max="500" oninput="calculateTDEE()">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-activity">Activity Level</label>
                    <select id="inp-activity" class="calc-input" onchange="calculateTDEE()">
                        <option value="1.2">Sedentary (Desk job, little exercise)</option>
                        <option value="1.375" selected>Lightly Active (Workout 1-3 days/week)</option>
                        <option value="1.55">Moderately Active (Workout 3-5 days/week)</option>
                        <option value="1.725">Very Active (Heavy training 6-7 days/week)</option>
                        <option value="1.9">Extra Active (Athlete / Intense physical labor)</option>
                    </select>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Total Daily Energy Expenditure (TDEE)</div>
                    <div class="result-main-val" id="tdee-val">2,335 kcal/day</div>
                    <div style="margin-top:0.35rem; color:var(--text-secondary); font-size:0.88rem;">Weekly energy burn: <strong id="tdee-weekly">16,345 kcal</strong></div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">Basal Metabolism (BMR)</div>
                        <div class="metric-item-val" id="bmr-val">1,698 kcal</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Active Burn (TEPA / NEAT)</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="active-burn-val">637 kcal</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="tdeeChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>Understanding the 4 Components of TDEE</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Component</th>
                            <th>Share of Daily Energy</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>BMR (Basal Metabolic Rate)</strong></td>
                            <td>60% – 70%</td>
                            <td>Energy needed to sustain vital organs at complete rest</td>
                        </tr>
                        <tr>
                            <td><strong>NEAT (Non-Exercise Activity)</strong></td>
                            <td>15% – 20%</td>
                            <td>Energy spent on walking, fidgeting, working, and daily tasks</td>
                        </tr>
                        <tr>
                            <td><strong>EAT (Exercise Activity)</strong></td>
                            <td>5% – 15%</td>
                            <td>Direct energy burned during gym, running, or sports workouts</td>
                        </tr>
                        <tr>
                            <td><strong>TEF (Thermic Effect of Food)</strong></td>
                            <td>8% – 10%</td>
                            <td>Energy expended to digest, absorb, and metabolize nutrients</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let tdeeChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateTDEE();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateTDEE();
    }

    function calculateTDEE() {
        let weightKg, heightCm;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('inp-weight-kg').value) || 70;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 175;
        } else {
            const lbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 154;
            const ft = parseFloat(document.getElementById('inp-height-ft').value) || 5;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 9;
            weightKg = lbs * 0.45359237;
            heightCm = (ft * 12 + inches) * 2.54;
        }

        const age = parseFloat(document.getElementById('inp-age').value) || 28;
        const activity = parseFloat(document.getElementById('inp-activity').value) || 1.375;

        let bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * age);
        bmr = Math.round(gender === 'male' ? bmr + 5 : bmr - 161);

        const tdee = Math.round(bmr * activity);
        const activeBurn = tdee - bmr;

        document.getElementById('tdee-val').innerText = `${tdee.toLocaleString()} kcal/day`;
        document.getElementById('tdee-weekly').innerText = `${(tdee * 7).toLocaleString()} kcal`;
        document.getElementById('bmr-val').innerText = `${bmr.toLocaleString()} kcal`;
        document.getElementById('active-burn-val').innerText = `${activeBurn.toLocaleString()} kcal`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('tdeeChart');
            if (ctx) {
                if (tdeeChart) tdeeChart.destroy();
                tdeeChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`BMR (${bmr} kcal)`, `Active Expenditure (${activeBurn} kcal)`],
                        datasets: [{
                            data: [bmr, activeBurn],
                            backgroundColor: ['#10b981', '#0284c7'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', size: 12 } } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateTDEE);
</script>

<%- include('partials/inner_footer') %>