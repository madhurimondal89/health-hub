<%- include('partials/inner_header') %>

<main class="main-content">
    <div class="container">
        <div class="calculator-container">
            <h1 class="calculator-title">Diabetes Risk Calculator</h1>
            <p class="calculator-subtitle">Based on the FINDRISC (Finnish Diabetes Risk Score) method</p>

            <div style="max-width:580px; margin:0 auto;">
                <!-- Age -->
                <div class="form-group">
                    <label>Your Age</label>
                    <div class="input-wrapper">
                        <select id="dr-age">
                            <option value="0">Under 45 years</option>
                            <option value="2">45–54 years</option>
                            <option value="3">55–64 years</option>
                            <option value="4">Over 64 years</option>
                        </select>
                    </div>
                </div>

                <!-- BMI -->
                <div class="form-group">
                    <label>Body Mass Index (BMI) — <a href="/bmi-calculator" style="color:var(--accent);font-size:0.82rem;">Calculate BMI →</a></label>
                    <div class="input-wrapper">
                        <select id="dr-bmi">
                            <option value="0">Less than 25 (Normal)</option>
                            <option value="1">25–30 (Overweight)</option>
                            <option value="3">Over 30 (Obese)</option>
                        </select>
                    </div>
                </div>

                <!-- Waist -->
                <div class="form-group">
                    <label>Waist Circumference</label>
                    <div class="unit-switcher" style="margin-bottom:0.75rem;">
                        <button class="unit-btn active" id="waist-male-btn" onclick="switchWaistGender('male')">Male</button>
                        <button class="unit-btn" id="waist-female-btn" onclick="switchWaistGender('female')">Female</button>
                    </div>
                    <div id="waist-male-opts">
                        <div class="input-wrapper">
                            <select id="dr-waist-male">
                                <option value="0">Less than 94 cm / 37 in (Low)</option>
                                <option value="3">94–102 cm / 37–40 in (Elevated)</option>
                                <option value="4">Over 102 cm / 40 in (High)</option>
                            </select>
                        </div>
                    </div>
                    <div id="waist-female-opts" style="display:none;">
                        <div class="input-wrapper">
                            <select id="dr-waist-female">
                                <option value="0">Less than 80 cm / 31.5 in (Low)</option>
                                <option value="3">80–88 cm / 31.5–34.5 in (Elevated)</option>
                                <option value="4">Over 88 cm / 34.5 in (High)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Physical Activity -->
                <div class="form-group">
                    <label>Physical Activity (at least 30 min/day or 3 hrs/week)</label>
                    <div class="input-wrapper">
                        <select id="dr-activity">
                            <option value="0">Yes, I am physically active</option>
                            <option value="2">No, I am not physically active</option>
                        </select>
                    </div>
                </div>

                <!-- Diet -->
                <div class="form-group">
                    <label>Do you eat vegetables, fruits or berries daily?</label>
                    <div class="input-wrapper">
                        <select id="dr-diet">
                            <option value="0">Yes, every day</option>
                            <option value="1">Not every day</option>
                        </select>
                    </div>
                </div>

                <!-- Blood Glucose -->
                <div class="form-group">
                    <label>Have you ever had high blood glucose? (during illness, pregnancy, etc.)</label>
                    <div class="input-wrapper">
                        <select id="dr-glucose">
                            <option value="0">No</option>
                            <option value="5">Yes</option>
                        </select>
                    </div>
                </div>

                <!-- Family History -->
                <div class="form-group">
                    <label>Family history of Type 2 diabetes</label>
                    <div class="input-wrapper">
                        <select id="dr-family">
                            <option value="0">No family history</option>
                            <option value="3">Grandparent, aunt, uncle, or first cousin</option>
                            <option value="5">Parent, sibling, or own child</option>
                        </select>
                    </div>
                </div>

                <button class="main-action-btn" onclick="calculateDiabetes()">Calculate My Risk</button>

                <div id="diabetes-result" style="margin-top:1.5rem;"></div>
            </div>

            <!-- FAQ -->
            <div class="faq-section">
                <h2>About the FINDRISC Score</h2>
                <div class="accordion-item">
                    <button class="accordion-header">What is FINDRISC? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>FINDRISC (Finnish Diabetes Risk Score) is a validated questionnaire developed in Finland to assess the 10-year risk of developing Type 2 diabetes. It uses 8 simple questions and requires no blood test, making it ideal for population screening.</p></div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-header">How accurate is this tool? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>FINDRISC has a sensitivity of ~78% and specificity of ~77% for detecting undiagnosed Type 2 diabetes. It is a screening tool, not a diagnosis. Always consult your doctor for clinical evaluation.</p></div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-header">Can I prevent Type 2 diabetes? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>Yes! Studies show that lifestyle interventions (healthy diet, regular exercise, modest weight loss) can reduce the risk by 58%. Even modest changes — walking 30 minutes daily and losing 5–7% of body weight — make a significant difference.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/inner_footer') %>

<script>
let waistGender = 'male';

function switchWaistGender(g) {
    waistGender = g;
    document.getElementById('waist-male-opts').style.display = g === 'male' ? '' : 'none';
    document.getElementById('waist-female-opts').style.display = g === 'female' ? '' : 'none';
    document.getElementById('waist-male-btn').classList.toggle('active', g === 'male');
    document.getElementById('waist-female-btn').classList.toggle('active', g === 'female');
}

function calculateDiabetes() {
    const age      = parseInt(document.getElementById('dr-age').value);
    const bmi      = parseInt(document.getElementById('dr-bmi').value);
    const waist    = parseInt(document.getElementById(waistGender === 'male' ? 'dr-waist-male' : 'dr-waist-female').value);
    const activity = parseInt(document.getElementById('dr-activity').value);
    const diet     = parseInt(document.getElementById('dr-diet').value);
    const glucose  = parseInt(document.getElementById('dr-glucose').value);
    const family   = parseInt(document.getElementById('dr-family').value);

    const score = age + bmi + waist + activity + diet + glucose + family;

    let risk, riskClass, riskColor, advice;
    if (score <= 7) {
        risk = 'Low'; riskClass = 'risk-healthy'; riskColor = '#00e676';
        advice = 'Estimated 1 in 100 chance of developing Type 2 diabetes in the next 10 years. Maintain your healthy lifestyle!';
    } else if (score <= 11) {
        risk = 'Slightly Elevated'; riskClass = 'risk-low'; riskColor = '#3b82f6';
        advice = 'Estimated 1 in 25 chance. Focus on regular physical activity and a balanced diet rich in vegetables and whole grains.';
    } else if (score <= 14) {
        risk = 'Moderate'; riskClass = 'risk-moderate'; riskColor = '#f59e0b';
        advice = 'Estimated 1 in 6 chance. Strongly consider lifestyle improvements. A clinical blood glucose test is recommended.';
    } else if (score <= 20) {
        risk = 'High'; riskClass = 'risk-high'; riskColor = '#ef4444';
        advice = 'Estimated 1 in 3 chance. Please consult your doctor for a fasting blood glucose or HbA1c test.';
    } else {
        risk = 'Very High'; riskClass = 'risk-high'; riskColor = '#dc2626';
        advice = 'Estimated 1 in 2 chance. Immediate consultation with your doctor is strongly advised.';
    }

    document.getElementById('diabetes-result').innerHTML = `
        <div class="result-display-new">
            <p class="result-main-text">Your FINDRISC Score: <strong>${score} / 26</strong></p>
            <div style="margin:0.75rem 0;">
                <span class="risk-indicator ${riskClass}" style="background:${riskColor};color:${riskClass==='risk-healthy'||riskClass==='risk-moderate'?'#060d1a':'#fff'};font-size:0.9rem;padding:0.35rem 1rem;">Risk Level: ${risk}</span>
            </div>
            <hr class="result-divider">
            <p class="result-sub-text">${advice}</p>
            <p class="result-sub-text" style="margin-top:0.75rem;font-size:0.8rem;color:var(--text-muted);">⚕️ This is a screening tool only. Consult a healthcare professional for medical advice.</p>
        </div>
    `;
}

document.querySelectorAll('.accordion-header').forEach(btn => {
    btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const content = btn.nextElementSibling;
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.accordion-item').forEach(i => { i.classList.remove('active'); i.querySelector('.accordion-content').style.maxHeight = null; });
        if (!isActive) { item.classList.add('active'); content.style.maxHeight = content.scrollHeight + 'px'; }
    });
});
</script>
