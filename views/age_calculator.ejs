<%- include('partials/inner_header') %>

<main class="main-content">
    <div class="container">
        <div class="calculator-container">
            <h1 class="calculator-title">Age Calculator</h1>
            <p class="calculator-subtitle">Find your exact age in years, months, days — and more!</p>

            <div style="max-width:520px; margin:0 auto;">
                <div class="form-group">
                    <label for="dob">Date of Birth</label>
                    <div class="input-wrapper">
                        <input type="date" id="dob" max="">
                    </div>
                </div>

                <div class="form-group">
                    <label for="target-date">Age As Of Date <small style="color:var(--text-muted)">(default: today)</small></label>
                    <div class="input-wrapper">
                        <input type="date" id="target-date">
                    </div>
                </div>

                <button class="main-action-btn" onclick="calculateAge()">Calculate My Age</button>

                <div id="age-result" style="margin-top:1.5rem;"></div>
            </div>

            <!-- FAQ -->
            <div class="faq-section">
                <h2>Frequently Asked Questions</h2>
                <div class="accordion-item">
                    <button class="accordion-header">How is exact age calculated? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>Exact age is calculated by counting the complete years, months, and days from the date of birth to the target date. Months have different lengths (28–31 days), and leap years add an extra day in February, which are all accounted for.</p></div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-header">What day of the week was I born? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>JavaScript's Date object uses the Gregorian calendar to calculate the day of the week for any historical date. Simply enter your date of birth and the calculator will tell you what day you were born.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/inner_footer') %>

<script>
// Set max date to today
const today = new Date();
const todayStr = today.toISOString().split('T')[0];
document.getElementById('dob').max = todayStr;
document.getElementById('target-date').value = todayStr;
document.getElementById('target-date').max = todayStr;

const days_of_week = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const months_names = ['January','February','March','April','May','June','July','August','September','October','November','December'];

function calculateAge() {
    const dobVal = document.getElementById('dob').value;
    const targetVal = document.getElementById('target-date').value;
    const resultEl = document.getElementById('age-result');

    if (!dobVal) {
        resultEl.innerHTML = '<div class="result-display-new"><p class="result-main-text" style="color:#f87171">Please select your date of birth.</p></div>';
        return;
    }

    const dob    = new Date(dobVal);
    const target = targetVal ? new Date(targetVal) : new Date();

    if (dob > target) {
        resultEl.innerHTML = '<div class="result-display-new"><p class="result-main-text" style="color:#f87171">Date of birth cannot be after the target date.</p></div>';
        return;
    }

    let years  = target.getFullYear() - dob.getFullYear();
    let months = target.getMonth()    - dob.getMonth();
    let daysR  = target.getDate()     - dob.getDate();

    if (daysR < 0) {
        months--;
        const prevMonth = new Date(target.getFullYear(), target.getMonth(), 0);
        daysR += prevMonth.getDate();
    }
    if (months < 0) { years--; months += 12; }

    // Total counts
    const totalDays    = Math.floor((target - dob) / (1000*60*60*24));
    const totalWeeks   = Math.floor(totalDays / 7);
    const totalMonths  = years * 12 + months;
    const totalHours   = totalDays * 24;
    const totalMins    = totalHours * 60;

    // Birthday info
    const dobDayName  = days_of_week[dob.getDay()];
    const dobMonthName= months_names[dob.getMonth()];

    // Next birthday
    let nextBday = new Date(target.getFullYear(), dob.getMonth(), dob.getDate());
    if (nextBday <= target) nextBday.setFullYear(nextBday.getFullYear() + 1);
    const daysToNextBday = Math.ceil((nextBday - target) / (1000*60*60*24));

    resultEl.innerHTML = `
        <div class="result-display-new">
            <p class="result-main-text" style="text-align:center">You are</p>
            <p style="text-align:center;font-size:2.5rem;font-weight:800;color:var(--accent);line-height:1;margin:0.5rem 0">${years}</p>
            <p style="text-align:center;font-size:1rem;font-weight:600;color:var(--text-secondary);margin:0 0 1rem">years old</p>
            <p style="text-align:center;color:var(--text-primary);font-size:1.05rem;font-weight:600">${years} years, ${months} months, ${daysR} days</p>
            <hr class="result-divider">
            <p class="result-sub-text">You were born on a <strong style="color:var(--accent)">${dobDayName}</strong>, ${dobMonthName} ${dob.getDate()}, ${dob.getFullYear()}</p>
        </div>
        <div class="activity-table-container">
            <h4>Detailed Breakdown</h4>
            <table class="activity-table">
                <tbody>
                    <tr><td>Total Months</td><td><strong>${totalMonths.toLocaleString()}</strong></td></tr>
                    <tr><td>Total Weeks</td><td><strong>${totalWeeks.toLocaleString()}</strong></td></tr>
                    <tr><td>Total Days</td><td><strong>${totalDays.toLocaleString()}</strong></td></tr>
                    <tr><td>Total Hours</td><td><strong>${totalHours.toLocaleString()}</strong></td></tr>
                    <tr><td>Total Minutes</td><td><strong>${totalMins.toLocaleString()}</strong></td></tr>
                    <tr><td>🎂 Days to Next Birthday</td><td><strong style="color:var(--accent)">${daysToNextBday} days</strong></td></tr>
                </tbody>
            </table>
        </div>
    `;
}

document.querySelectorAll('.accordion-header').forEach(btn => {
    btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const content = btn.nextElementSibling;
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.accordion-item').forEach(i => { i.classList.remove('active'); i.querySelector('.accordion-content').style.maxHeight = null; });
        if (!isActive) { item.classList.add('active'); content.style.maxHeight = content.scrollHeight + 'px'; }
    });
});
</script>
