<%- include('partials/header') %>

<main>
    <div class="container">
        <!-- ===== HERO SECTION ===== -->
        <section class="hero-section">
            <div class="hero-glow"></div>
            
            <div class="hero-badge">
                <span>⚡</span> <%= calculators.length %>+ Medically Verified · Free · Instant Health Calculators
            </div>

            <h1 class="hero-title">
                Your Complete<br>
                <span class="gradient-text">Health &amp; Fitness Calculator</span> Hub
            </h1>

            <p class="hero-subtitle">
                Access over <strong><%= calculators.length %>+</strong> free evidence-based health calculators — Body Composition, Calories, Macros, Workouts, Clinical Vitals, Pregnancy, and Sleep.
            </p>

            <!-- Stats Bar -->
            <div class="stats-bar">
                <div class="stat-pill">
                    <span class="num"><%= calculators.length %>+</span> Health Calculators
                </div>
                <div class="stat-pill">
                    <span class="num">8</span> Health Categories
                </div>
                <div class="stat-pill">
                    <span class="num">100%</span> Free &amp; Private
                </div>
            </div>

            <!-- ===== OFFICIAL PUBLIC HEALTH ADVISORY SLIDER (GOVT & WHO STANDARDS) ===== -->
            <div class="health-advisory-carousel" id="health-advisory-widget">
                <div class="advisory-header-row">
                    <div class="advisory-badge-live">
                        <span class="pulse-dot"></span>
                        <span>Official Public Health Guidelines</span>
                    </div>

                    <div class="advisory-controls">
                        <button type="button" class="advisory-nav-btn" onclick="prevAdvisorySlide()" title="Previous Tip" aria-label="Previous Advisory">‹</button>
                        <button type="button" class="advisory-nav-btn" onclick="nextAdvisorySlide()" title="Next Tip" aria-label="Next Advisory">›</button>
                    </div>
                </div>

                <div class="advisory-slides-wrapper">
                    <!-- Slide 1: No Smoking & Tobacco -->
                    <div class="advisory-slide active" data-slide="0">
                        <div class="advisory-icon-box" style="border-color:rgba(244,63,94,0.3); background:rgba(244,63,94,0.08);">🚭</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Say No to Tobacco &amp; Smoking</span>
                                <span class="card-category-tag" style="background:#f43f5e; color:#fff; font-size:0.72rem;">WHO &amp; Ministry Advisory</span>
                            </div>
                            <div class="advisory-desc">
                                Tobacco consumption causes irreversible arterial plaque, COPD, and stroke. <strong>Quitting smoking cuts coronary heart disease risk by 50% within just 1 year.</strong> Protect yourself and your family from secondhand smoke.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#QuitSmoking</span>
                                <span class="advisory-tag">#LungHealth</span>
                                <span class="advisory-tag">#HeartCare</span>
                                <a href="https://www.who.int/health-topics/tobacco" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ Official WHO Tobacco Portal ↗
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2: 150 Mins Physical Activity -->
                    <div class="advisory-slide" data-slide="1">
                        <div class="advisory-icon-box" style="border-color:rgba(16,185,129,0.3); background:rgba(16,185,129,0.08);">🏃‍♂️</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Stay Active: 150–300 Minutes Moderate Exercise Weekly</span>
                                <span class="card-category-tag" style="background:#10b981; color:#fff; font-size:0.72rem;">WHO Global Standard</span>
                            </div>
                            <div class="advisory-desc">
                                Aim for at least <strong>30 minutes of brisk walking, cycling, or swimming 5 days a week</strong>. Regular moderate physical activity significantly lowers type 2 diabetes risk, manages resting blood pressure, and improves mental health.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#PhysicalActivity</span>
                                <span class="advisory-tag">#ActiveLiving</span>
                                <span class="advisory-tag">#PreventDiabetes</span>
                                <a href="https://www.who.int/news-room/fact-sheets/detail/physical-activity" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ WHO Physical Activity Guidelines ↗
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 3: Limit Salt & Sugar -->
                    <div class="advisory-slide" data-slide="2">
                        <div class="advisory-icon-box" style="border-color:rgba(245,158,11,0.3); background:rgba(245,158,11,0.08);">🧂</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Cut Hidden Salt (&lt;5g/day) &amp; Free Added Sugars (&lt;25g/day)</span>
                                <span class="card-category-tag" style="background:#f59e0b; color:#fff; font-size:0.72rem;">ICMR &amp; Dietary Guidelines</span>
                            </div>
                            <div class="advisory-desc">
                                Excessive dietary sodium drives hypertension and kidney stress. <strong>Limit daily salt to less than 1 level teaspoon (&lt;5g)</strong> and minimize sugary sodas, packaged desserts, and ultra-processed snacks.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#LowSodium</span>
                                <span class="advisory-tag">#BloodPressure</span>
                                <span class="advisory-tag">#KidneyCare</span>
                                <a href="https://www.who.int/news-room/fact-sheets/detail/salt-reduction" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ WHO Salt Reduction Guide ↗
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 4: 7-9 Hours Circadian Sleep -->
                    <div class="advisory-slide" data-slide="3">
                        <div class="advisory-icon-box" style="border-color:rgba(99,102,241,0.3); background:rgba(99,102,241,0.08);">😴</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Prioritize 7 to 9 Hours of Quality Nighttime Sleep</span>
                                <span class="card-category-tag" style="background:#6366f1; color:#fff; font-size:0.72rem;">Sleep Hygiene Guideline</span>
                            </div>
                            <div class="advisory-desc">
                                Consistent sleep regulates hunger hormones (ghrelin &amp; leptin), reduces systemic inflammation, and consolidates brain memory. <strong>Avoid digital screens 60 minutes before bedtime</strong> for deeper restorative sleep.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#SleepHygiene</span>
                                <span class="advisory-tag">#MentalWellness</span>
                                <span class="advisory-tag">#StressRelief</span>
                                <a href="https://www.cdc.gov/sleep/about/index.html" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ CDC Sleep Health Portal ↗
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 5: Safe Hydration & Heat Wave Protection -->
                    <div class="advisory-slide" data-slide="4">
                        <div class="advisory-icon-box" style="border-color:rgba(2,132,199,0.3); background:rgba(2,132,199,0.08);">💧</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Drink 2.5 to 3.5 Liters of Water &amp; Avoid Peak Sun</span>
                                <span class="card-category-tag" style="background:#0284c7; color:#fff; font-size:0.72rem;">Govt Heat &amp; Vitals Advisory</span>
                            </div>
                            <div class="advisory-desc">
                                Drink water regularly throughout the day before feeling thirsty. During high summer heatwaves, avoid strenuous outdoor exertion between <strong>12 PM and 3 PM</strong>, wear breathable cottons, and stay well hydrated.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#StayHydrated</span>
                                <span class="advisory-tag">#HeatProtection</span>
                                <span class="advisory-tag">#CleanWater</span>
                                <a href="https://www.who.int/news-room/fact-sheets/detail/climate-change-heat-and-health" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ WHO Heat &amp; Health Guide ↗
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 6: Annual Preventative Health Screenings -->
                    <div class="advisory-slide" data-slide="5">
                        <div class="advisory-icon-box" style="border-color:rgba(139,92,246,0.3); background:rgba(139,92,246,0.08);">🩺</div>
                        <div class="advisory-content">
                            <div class="advisory-title">
                                <span>Schedule Annual Preventative Medical Screenings</span>
                                <span class="card-category-tag" style="background:#8b5cf6; color:#fff; font-size:0.72rem;">Clinical Health Protocol</span>
                            </div>
                            <div class="advisory-desc">
                                Early detection is the best cure. <strong>Check your Blood Pressure, Fasting Blood Sugar (HbA1c), and Lipid Profile annually</strong> to detect cardiovascular or metabolic risks early. Always follow a certified doctor's counsel.
                            </div>
                            <div class="advisory-tags" style="align-items: center;">
                                <span class="advisory-tag">#AnnualCheckup</span>
                                <span class="advisory-tag">#EarlyDetection</span>
                                <span class="advisory-tag">#PreventativeCare</span>
                                <a href="https://nhp.gov.in/" target="_blank" rel="noopener noreferrer" class="advisory-link-btn">
                                    🏛️ National Health Portal (NHP) ↗
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Dots -->
                <div class="advisory-dots" id="advisory-dots-wrap">
                    <span class="advisory-dot active" onclick="goToAdvisorySlide(0)"></span>
                    <span class="advisory-dot" onclick="goToAdvisorySlide(1)"></span>
                    <span class="advisory-dot" onclick="goToAdvisorySlide(2)"></span>
                    <span class="advisory-dot" onclick="goToAdvisorySlide(3)"></span>
                    <span class="advisory-dot" onclick="goToAdvisorySlide(4)"></span>
                    <span class="advisory-dot" onclick="goToAdvisorySlide(5)"></span>
                </div>
            </div>
        </section>

        <!-- ===== FEATURED LIVE API ENGINES & ESSENTIAL HEALTH TOOLS ===== -->
        <section class="featured-engines-section" style="margin: 1.5rem 0 2.5rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div>
                    <div style="font-size: 0.8rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.4rem;">
                        <span class="pulse-dot"></span> Live Public Health APIs
                    </div>
                    <h2 style="font-family: var(--font-heading); font-size: 1.45rem; font-weight: 800; color: var(--text-primary); margin-top: 0.2rem;">
                        ⚡ Live Health Engines &amp; Essential Tools
                    </h2>
                </div>
                <span class="card-category-tag" style="background: var(--primary-light); color: var(--primary); font-weight: 700; padding: 0.4rem 1rem;">
                    100% Free Live Public Data
                </span>
            </div>

            <div class="featured-engines-grid">
                <!-- 1. Live Food Nutrition -->
                <a href="/food-nutrition-lookup" class="featured-engine-card">
                    <div>
                        <div class="engine-top">
                            <div class="engine-icon" style="background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.25);">🍎</div>
                            <span class="engine-badge" style="background:rgba(239,68,68,0.15); color:#ef4444;">
                                Open Food Facts API
                            </span>
                        </div>
                        <h3>Live Food Nutrition &amp; Calorie Lookup</h3>
                        <p>Search over 100,000+ foods and fruits with instant calorie, protein, carbs, healthy fats, and micronutrient breakdown.</p>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-weight:700; color:var(--primary); font-size:0.92rem; margin-top:0.5rem;">
                        <span>Launch Food Search</span>
                        <span>→</span>
                    </div>
                </a>

                <!-- 2. OpenFDA Drug Safety -->
                <a href="/drug-safety-checker" class="featured-engine-card">
                    <div>
                        <div class="engine-top">
                            <div class="engine-icon" style="background:rgba(225,29,72,0.1); border-color:rgba(225,29,72,0.25);">💊</div>
                            <span class="engine-badge" style="background:rgba(225,29,72,0.15); color:#e11d48;">
                                Official FDA API
                            </span>
                        </div>
                        <h3>OpenFDA Drug Safety &amp; Clinical Warnings</h3>
                        <p>Search official US FDA drug labels, active pharmacological substances, dosage guidelines, and adverse side effects.</p>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-weight:700; color:var(--primary); font-size:0.92rem; margin-top:0.5rem;">
                        <span>Verify Medication</span>
                        <span>→</span>
                    </div>
                </a>

                <!-- 3. Live Workout Library -->
                <a href="/exercise-workout-library" class="featured-engine-card">
                    <div>
                        <div class="engine-top">
                            <div class="engine-icon" style="background:rgba(2,132,199,0.1); border-color:rgba(2,132,199,0.25);">🏋️‍♂️</div>
                            <span class="engine-badge" style="background:rgba(2,132,199,0.15); color:#0284c7;">
                                wger Exercise API
                            </span>
                        </div>
                        <h3>Live Workout &amp; Muscle Exercise Explorer</h3>
                        <p>Explore 800+ exercises by muscle anatomy (Chest, Back, Legs, Core) with real-time MET calorie burn calculations.</p>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-weight:700; color:var(--primary); font-size:0.92rem; margin-top:0.5rem;">
                        <span>Explore Exercises</span>
                        <span>→</span>
                    </div>
                </a>

                <!-- 4. Live Solar UV & Vitamin D -->
                <a href="/uv-index-vitamin-d-calculator" class="featured-engine-card">
                    <div>
                        <div class="engine-top">
                            <div class="engine-icon" style="background:rgba(245,158,11,0.1); border-color:rgba(245,158,11,0.25);">☀️</div>
                            <span class="engine-badge" style="background:rgba(245,158,11,0.15); color:#f59e0b;">
                                Open-Meteo Solar API
                            </span>
                        </div>
                        <h3>Live UV Index &amp; Solar Vitamin D Calculator</h3>
                        <p>Real-time solar UV radiation calculator estimating safe sun exposure time needed for optimal Vitamin D synthesis.</p>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-weight:700; color:var(--primary); font-size:0.92rem; margin-top:0.5rem;">
                        <span>Check UV Forecast</span>
                        <span>→</span>
                    </div>
                </a>
            </div>
        </section>

        <!-- Advertisement Unit Placed Above Search -->
        <%- include('partials/ad_unit') %>

        <!-- Category Filters & Live Search Box -->
        <section style="margin-bottom: 2.5rem;">
            <!-- Category Filter Pills with Dynamic Counts -->
            <div class="category-filter-wrap" id="category-filters" style="margin-bottom: 2rem;">
                <button class="filter-btn active" data-cat="all" onclick="selectCategory('all')">
                    🌟 All Calculators (<%= calculators.length %>)
                </button>
                <% Object.keys(categories).forEach(function(catKey) { %>
                    <button class="filter-btn" data-cat="<%= catKey %>" onclick="selectCategory('<%= catKey %>')">
                        <%= categories[catKey].icon %> <%= categories[catKey].name %> (<%= categoryCounts[catKey] || 0 %>)
                    </button>
                <% }); %>
            </div>

            <!-- Live Search Box (Positioned directly above calculator cards) -->
            <div class="search-wrapper" style="margin-bottom: 0;">
                <span class="search-icon">🔍</span>
                <input
                    type="text"
                    id="calc-search"
                    class="search-input-box"
                    placeholder="Search 500+ health calculators... (e.g. BMI, BMR, Calorie Deficit, Sleep, Blood Pressure, 1RM)"
                    autocomplete="off"
                    oninput="filterCalculators()"
                >
            </div>
        </section>

        <!-- ===== CALCULATOR CARDS GRID ===== -->
        <div id="no-results" style="display:none; text-align:center; padding: 4rem 1rem;">
            <div style="font-size:3rem;margin-bottom:0.75rem;">🔍</div>
            <h3 style="font-family:var(--font-heading); margin-bottom:0.5rem;">No health calculators match your search</h3>
            <p style="color:var(--text-muted);margin-bottom:1.5rem;">Try searching for terms like "BMI", "Calorie", "Protein", "Sleep", "Heart Rate", or "Due Date".</p>
            <button class="filter-btn active" style="margin:0 auto;" onclick="resetSearch()">Clear Search</button>
        </div>

        <div class="calc-grid" id="calculators-container">
            <% calculators.forEach(function(calc) { %>
                <a 
                    href="<%= calc.url %>" 
                    class="calc-card" 
                    data-category="<%= calc.category %>"
                    data-name="<%= calc.name.toLowerCase() %>"
                    data-desc="<%= calc.description.toLowerCase() %>"
                    data-tags="<%= (calc.tags || []).join(' ').toLowerCase() %>"
                >
                    <div class="card-top">
                        <div class="card-icon-box"><%= calc.icon %></div>
                        <span class="card-category-tag"><%= calc.categoryName %></span>
                    </div>
                    <h3><%= calc.name %></h3>
                    <p><%= calc.description %></p>
                    
                    <% if (calc.tags && calc.tags.length > 0) { %>
                        <div class="card-tags">
                            <% calc.tags.slice(0, 3).forEach(function(tag) { %>
                                <span class="card-tag">#<%= tag %></span>
                            <% }); %>
                        </div>
                    <% } %>

                    <div class="card-action">
                        <span>Calculate Now</span>
                        <span>→</span>
                    </div>
                </a>
            <% }); %>
        </div>

        <%- include('partials/ad_unit') %>

        <!-- ===== FAQ SECTION ===== -->
        <section class="info-section">
            <h2>Frequently Asked Questions About Health Hub</h2>
            <div class="faq-list">
                <div class="faq-item open">
                    <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                        <span>Are all 500+ health calculators on Health Hub free?</span>
                        <span>▼</span>
                    </button>
                    <div class="faq-answer">
                        <p>Yes, 100% free! Every calculator on Health Hub is accessible to everyone with zero subscriptions, paywalls, or accounts needed.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                        <span>Are the health formulas scientifically validated?</span>
                        <span>▼</span>
                    </button>
                    <div class="faq-answer">
                        <p>All calculations utilize globally recognized medical and physiological standards, including Mifflin-St Jeor (BMR), Devine & Robinson (Ideal Weight), U.S. Navy Body Fat, FINDRISC (Diabetes), AHA (Blood Pressure), and WHO/CDC pediatric percentiles.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                        <span>Is my health information kept private?</span>
                        <span>▼</span>
                    </button>
                    <div class="faq-answer">
                        <p>Yes. All calculations occur locally in your browser. We never save, store, or sell your private personal metrics or body measurements.</p>
                    </div>
                </div>
            </div>
        </section>

    </div>
</main>

<script>
    let activeCategory = 'all';

    function selectCategory(cat) {
        activeCategory = cat;
        document.querySelectorAll('#category-filters .filter-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-cat') === cat);
        });
        filterCalculators();
    }

    function resetSearch() {
        document.getElementById('calc-search').value = '';
        selectCategory('all');
    }

    function filterCalculators() {
        const query = document.getElementById('calc-search').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.calc-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            const cardName = card.getAttribute('data-name');
            const cardDesc = card.getAttribute('data-desc');
            const cardTags = card.getAttribute('data-tags');

            const matchesCat = (activeCategory === 'all' || cardCat === activeCategory);
            const matchesSearch = !query || cardName.includes(query) || cardDesc.includes(query) || cardTags.includes(query);

            if (matchesCat && matchesSearch) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('no-results').style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // ===== OFFICIAL PUBLIC HEALTH ADVISORY CAROUSEL LOGIC =====
    let currentAdvisoryIdx = 0;
    const totalAdvisorySlides = 6;
    let advisoryTimer = null;

    function showAdvisorySlide(idx) {
        currentAdvisoryIdx = (idx + totalAdvisorySlides) % totalAdvisorySlides;
        
        // Update slides
        const slides = document.querySelectorAll('.advisory-slide');
        slides.forEach((s, i) => {
            s.classList.toggle('active', i === currentAdvisoryIdx);
        });

        // Update dots
        const dots = document.querySelectorAll('.advisory-dot');
        dots.forEach((d, i) => {
            d.classList.toggle('active', i === currentAdvisoryIdx);
        });
    }

    function nextAdvisorySlide() {
        showAdvisorySlide(currentAdvisoryIdx + 1);
        resetAdvisoryTimer();
    }

    function prevAdvisorySlide() {
        showAdvisorySlide(currentAdvisoryIdx - 1);
        resetAdvisoryTimer();
    }

    function goToAdvisorySlide(idx) {
        showAdvisorySlide(idx);
        resetAdvisoryTimer();
    }

    function startAdvisoryAutoPlay() {
        if (advisoryTimer) clearInterval(advisoryTimer);
        advisoryTimer = setInterval(() => {
            showAdvisorySlide(currentAdvisoryIdx + 1);
        }, 5000);
    }

    function resetAdvisoryTimer() {
        clearInterval(advisoryTimer);
        startAdvisoryAutoPlay();
    }

    document.addEventListener('DOMContentLoaded', () => {
        startAdvisoryAutoPlay();

        // Pause on hover
        const widget = document.getElementById('health-advisory-widget');
        if (widget) {
            widget.addEventListener('mouseenter', () => clearInterval(advisoryTimer));
            widget.addEventListener('mouseleave', () => startAdvisoryAutoPlay());
        }
    });
</script>

<%- include('partials/medical_disclaimer_banner') %>
<%- include('partials/footer') %>
