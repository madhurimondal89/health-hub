<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#diet-nutrition">Diet &amp; Nutrition</a> <span>›</span>
                <span>Keto Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🥑</div>
                <div class="calc-hero-text">
                    <h1>Ketogenic (Keto) Macro Calculator</h1>
                    <p>Calculate your daily Net Carbs (< 25g), Healthy Fats, and Protein targets to achieve and maintain nutritional ketosis.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🥑</span> Ketogenic Setup
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, ft-in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-age">Age</label>
                    <input type="number" id="inp-age" class="calc-input" value="28" min="15" max="95" oninput="calculateKeto()">
                </div>

                <div id="metric-inputs">
                    <div class="form-group">
                        <label class="form-label" for="inp-height-cm">Height (cm)</label>
                        <input type="number" id="inp-height-cm" class="calc-input" value="175" min="100" max="230" oninput="calculateKeto()">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-kg">Weight (kg)</label>
                        <input type="number" id="inp-weight-kg" class="calc-input" value="75" min="30" max="250" oninput="calculateKeto()">
                    </div>
                </div>

                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Height (ft &amp; in)</label>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                            <input type="number" id="inp-height-ft" class="calc-input" value="5" min="1" max="8" oninput="calculateKeto()">
                            <input type="number" id="inp-height-in" class="calc-input" value="9" min="0" max="11" oninput="calculateKeto()">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-weight-lbs">Weight (lbs)</label>
                        <input type="number" id="inp-weight-lbs" class="calc-input" value="165" min="50" max="500" oninput="calculateKeto()">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-carb-limit">Daily Net Carb Limit</label>
                    <select id="inp-carb-limit" class="calc-input" onchange="calculateKeto()">
                        <option value="20" selected>Strict Ketosis (20g Net Carbs)</option>
                        <option value="25">Standard Ketosis (25g Net Carbs)</option>
                        <option value="35">Liberal Keto (35g Net Carbs)</option>
                        <option value="50">Low Carb Transition (50g Net Carbs)</option>
                    </select>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Daily Ketogenic Calories</div>
                    <div class="result-main-val" id="keto-cal-val">1,795 kcal/day</div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">🥑 Healthy Fats (75%)</div>
                        <div class="metric-item-val" style="color:var(--accent-amber);" id="keto-fat-val">150 g</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">🍗 Moderate Protein (20%)</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="keto-prot-val">90 g</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">🥦 Net Carbs (5%)</div>
                        <div class="metric-item-val" style="color:var(--accent-blue);" id="keto-carb-val">20 g Limit</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">💧 Sodium / Potassium RDA</div>
                        <div class="metric-item-val" id="keto-elec-val">4,000 mg</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="ketoChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>The Science of Nutritional Ketosis</h2>
            <p>
                By restricting carbohydrates to under 20-25g daily, your liver turns dietary and body fats into <strong>beta-hydroxybutyrate (BHB) ketones</strong>, providing steady mental clarity and sustainable fat burning.
            </p>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let ketoChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateKeto();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateKeto();
    }

    function calculateKeto() {
        let weightKg, heightCm;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('inp-weight-kg').value) || 75;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 175;
        } else {
            const lbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 165;
            const ft = parseFloat(document.getElementById('inp-height-ft').value) || 5;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 9;
            weightKg = lbs * 0.45359237;
            heightCm = (ft * 12 + inches) * 2.54;
        }

        const age = parseFloat(document.getElementById('inp-age').value) || 28;
        const carbLimit = parseFloat(document.getElementById('inp-carb-limit').value) || 20;

        let bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * age);
        bmr = gender === 'male' ? bmr + 5 : bmr - 161;

        const calories = Math.round(bmr * 1.35 * 0.85); // 15% deficit standard keto
        const carbCalories = carbLimit * 4;
        const proteinGrams = Math.round(weightKg * 1.5); // 1.5g per kg
        const proteinCalories = proteinGrams * 4;
        const fatCalories = Math.max(500, calories - carbCalories - proteinCalories);
        const fatGrams = Math.round(fatCalories / 9);

        document.getElementById('keto-cal-val').innerText = `${calories.toLocaleString()} kcal/day`;
        document.getElementById('keto-fat-val').innerText = `${fatGrams} g (${Math.round((fatCalories/calories)*100)}%)`;
        document.getElementById('keto-prot-val').innerText = `${proteinGrams} g (${Math.round((proteinCalories/calories)*100)}%)`;
        document.getElementById('keto-carb-val').innerText = `${carbLimit} g Limit`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('ketoChart');
            if (ctx) {
                if (ketoChart) ketoChart.destroy();
                ketoChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Healthy Fats (${fatGrams}g)`, `Protein (${proteinGrams}g)`, `Net Carbs (${carbLimit}g)`],
                        datasets: [{
                            data: [fatCalories, proteinCalories, carbCalories],
                            backgroundColor: ['#f59e0b', '#10b981', '#0284c7'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateKeto);
</script>

<%- include('partials/inner_footer') %>
