<%- include('partials/inner_header') %>

<main class="main-content">
    <div class="container">
        <div class="calculator-container">
            <h1 class="calculator-title">Steps to Calories Calculator</h1>
            <p class="calculator-subtitle">Convert your daily steps into calories burned</p>

            <div class="calculator-grid">
                <!-- Input -->
                <div class="input-side">
                    <div class="unit-switcher">
                        <button class="unit-btn active" id="sc-btn-metric" onclick="scSwitchUnit('metric')">Metric (kg)</button>
                        <button class="unit-btn" id="sc-btn-imperial" onclick="scSwitchUnit('imperial')">Imperial (lbs)</button>
                    </div>

                    <div class="form-group">
                        <label for="sc-steps">Number of Steps</label>
                        <div class="input-wrapper">
                            <input type="number" id="sc-steps" placeholder="e.g. 10000" min="1" max="100000">
                            <span class="input-adornment">steps</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="sc-weight">Body Weight</label>
                        <div class="input-wrapper">
                            <input type="number" id="sc-weight" placeholder="e.g. 70" min="30" max="300">
                            <span class="input-adornment" id="sc-unit-label">kg</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Walking Pace</label>
                        <div class="input-wrapper">
                            <select id="sc-pace">
                                <option value="slow">Slow (< 3 km/h)</option>
                                <option value="normal" selected>Normal (3–5 km/h)</option>
                                <option value="brisk">Brisk (5–6.5 km/h)</option>
                                <option value="fast">Fast (> 6.5 km/h)</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="sc-height">Height <small style="color:var(--text-muted)">(for stride calculation)</small></label>
                        <div class="input-wrapper">
                            <input type="number" id="sc-height" placeholder="e.g. 170" min="100" max="250">
                            <span class="input-adornment" id="sc-height-label">cm</span>
                        </div>
                    </div>

                    <button class="main-action-btn" onclick="calculateSteps()">Calculate Calories</button>
                </div>

                <!-- Result -->
                <div class="result-section" id="steps-result">
                    <div class="placeholder">
                        <div class="placeholder-icon">👟</div>
                        <p>Enter your steps and weight above</p>
                    </div>
                </div>
            </div>

            <!-- Quick Reference -->
            <div style="margin-top:2.5rem; border-top:1px solid var(--glass-border); padding-top:2rem;">
                <h4 style="font-size:0.95rem;font-weight:600;color:var(--text-secondary);margin-bottom:1rem;">Quick Reference — 70 kg person, normal pace</h4>
                <div class="calculator-grid-home" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap:0.75rem;">
                    <% [
                        {steps:'1,000', cal:'40'},{steps:'5,000', cal:'200'},
                        {steps:'7,500', cal:'300'},{steps:'10,000', cal:'400'},
                        {steps:'12,500', cal:'500'},{steps:'15,000', cal:'600'}
                    ].forEach(r => { %>
                    <div style="background:var(--bg-input);border:1px solid var(--glass-border);border-radius:var(--radius-sm);padding:0.85rem 1rem;text-align:center;">
                        <div style="font-size:1.1rem;font-weight:700;color:var(--accent)"><%= r.steps %></div>
                        <div style="font-size:0.8rem;color:var(--text-muted)">steps</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-top:0.25rem">≈ <%= r.cal %> kcal</div>
                    </div>
                    <% }) %>
                </div>
            </div>

            <!-- FAQ -->
            <div class="faq-section">
                <h2>Frequently Asked Questions</h2>
                <div class="accordion-item">
                    <button class="accordion-header">How many steps should I walk daily? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>The popular goal of 10,000 steps/day is a good target for general health. Research shows that even 7,000–8,000 steps/day significantly reduces mortality risk. Any increase from your baseline is beneficial.</p></div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-header">How is stride length calculated? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>Average stride length is approximately 0.415 × height (cm) for walking. Taller people naturally take longer strides, covering more distance per step. Running stride is longer — roughly 0.67 × height.</p></div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-header">Does walking burn belly fat? <span class="icon">+</span></button>
                    <div class="accordion-content"><p>Yes! Walking consistently burns calories that contribute to a calorie deficit, which reduces overall body fat including visceral (belly) fat. Brisk walking is particularly effective. Combined with a healthy diet, 10,000 steps/day can help you lose 0.5–1 kg per week.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/inner_footer') %>

<script>
let scUnit = 'metric';

function scSwitchUnit(mode) {
    scUnit = mode;
    document.getElementById('sc-btn-metric').classList.toggle('active', mode === 'metric');
    document.getElementById('sc-btn-imperial').classList.toggle('active', mode === 'imperial');
    document.getElementById('sc-unit-label').textContent = mode === 'metric' ? 'kg' : 'lbs';
    document.getElementById('sc-height-label').textContent = mode === 'metric' ? 'cm' : 'in';
    document.getElementById('sc-weight').placeholder = mode === 'metric' ? 'e.g. 70' : 'e.g. 154';
    document.getElementById('sc-height').placeholder = mode === 'metric' ? 'e.g. 170' : 'e.g. 67';
}

function calculateSteps() {
    const steps = parseInt(document.getElementById('sc-steps').value);
    let weight  = parseFloat(document.getElementById('sc-weight').value);
    let height  = parseFloat(document.getElementById('sc-height').value);
    const pace  = document.getElementById('sc-pace').value;

    if (!steps || !weight || steps <= 0 || weight <= 0) {
        document.getElementById('steps-result').innerHTML = '<div class="result-display-new"><p class="result-main-text" style="color:#f87171">Please enter valid steps and weight.</p></div>';
        return;
    }

    if (scUnit === 'imperial') { weight *= 0.453592; height *= 2.54; }

    // Stride length (cm)
    const stride = height > 0 ? height * 0.415 : 75;
    const distanceKm = (steps * stride) / 100000;

    // MET values by pace
    const mets = { slow: 2.5, normal: 3.5, brisk: 4.8, fast: 7.0 };
    const met = mets[pace];

    // Time in hours = distance / speed
    const speeds = { slow: 2.5, normal: 4.0, brisk: 5.5, fast: 7.0 };
    const timeHr = distanceKm / speeds[pace];

    // Calories = MET × weight(kg) × time(hr)
    const calories = Math.round(met * weight * timeHr);
    const distanceMi = (distanceKm * 0.621371).toFixed(2);

    const paceLabels = { slow: 'Slow', normal: 'Normal', brisk: 'Brisk', fast: 'Fast' };

    document.getElementById('steps-result').innerHTML = `
        <div class="result-display-new" style="width:100%">
            <p class="result-main-text">Calories Burned</p>
            <p class="result-main-text-large"><strong>${calories}</strong></p>
            <p class="result-main-unit">kcal</p>
            <hr class="result-divider">
            <p class="result-sub-text">Steps: <strong style="color:var(--accent)">${steps.toLocaleString()}</strong></p>
            <p class="result-sub-text">Distance: <strong>${distanceKm.toFixed(2)} km</strong> (${distanceMi} mi)</p>
            <p class="result-sub-text">Pace: <strong>${paceLabels[pace]}</strong></p>
            <p class="result-sub-text">Duration: ≈ <strong>${Math.round(timeHr * 60)} min</strong></p>
        </div>
    `;
}

document.querySelectorAll('.accordion-header').forEach(btn => {
    btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const content = btn.nextElementSibling;
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.accordion-item').forEach(i => { i.classList.remove('active'); i.querySelector('.accordion-content').style.maxHeight = null; });
        if (!isActive) { item.classList.add('active'); content.style.maxHeight = content.scrollHeight + 'px'; }
    });
});
</script>
