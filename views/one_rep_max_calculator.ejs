<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#fitness-workouts">Fitness &amp; Workouts</a> <span>›</span>
                <span>One Rep Max (1RM) Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🏋️‍♂️</div>
                <div class="calc-hero-text">
                    <h1>One Rep Max (1RM) &amp; Lift Percentage Calculator</h1>
                    <p>Calculate your 1-Rep Max for Bench Press, Squat, and Deadlift along with training percentage loads (50% to 95%) using Epley &amp; Brzycki formulas.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🏋️‍♂️</span> Lift Information
                </div>

                <div class="form-group">
                    <label class="form-label">Units</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs)</button>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" id="lbl-weight" for="inp-weight">Weight Lifted</label>
                        <div class="preset-chips">
                            <span class="chip" onclick="setWeight(60)">60</span>
                            <span class="chip" onclick="setWeight(80)">80</span>
                            <span class="chip" onclick="setWeight(100)">100</span>
                            <span class="chip" onclick="setWeight(120)">120</span>
                        </div>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-weight" class="calc-input has-suffix" value="80" step="2.5" oninput="calculate1RM()">
                        <span class="input-symbol-suffix" id="unit-weight">kg</span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-reps">Repetitions Performed (1-12)</label>
                        <div class="preset-chips">
                            <span class="chip" onclick="setReps(3)">3 Reps</span>
                            <span class="chip" onclick="setReps(5)">5 Reps</span>
                            <span class="chip" onclick="setReps(8)">8 Reps</span>
                            <span class="chip" onclick="setReps(10)">10 Reps</span>
                        </div>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-reps" class="calc-input has-suffix" value="5" min="1" max="15" oninput="calculate1RM()">
                        <span class="input-symbol-suffix">Reps</span>
                    </div>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Estimated One Rep Max (1RM)</div>
                    <div class="result-main-val" id="one-rm-val">93.3 kg</div>
                    <div style="margin-top:0.35rem; font-size:0.88rem; color:var(--text-secondary);">Epley Formula standard</div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">90% 1RM (Heavy Strength)</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="pct-90-val">84.0 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">80% 1RM (Hypertrophy)</div>
                        <div class="metric-item-val" id="pct-80-val">74.7 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">70% 1RM (Speed / Volume)</div>
                        <div class="metric-item-val" id="pct-70-val">65.3 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">60% 1RM (Endurance / Warmup)</div>
                        <div class="metric-item-val" id="pct-60-val">56.0 kg</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="oneRmChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>Epley vs Brzycki 1RM Formulas</h2>
            <div class="formula-box">
                Epley Formula: 1RM = Weight × (1 + Reps / 30)<br>
                Brzycki Formula: 1RM = Weight × (36 / (37 - Reps))
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let oneRmChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        const isMetric = unit === 'metric';
        document.getElementById('unit-weight').innerText = isMetric ? 'kg' : 'lbs';
        document.getElementById('inp-weight').value = isMetric ? 80 : 175;
        calculate1RM();
    }

    function setWeight(w) {
        document.getElementById('inp-weight').value = w;
        calculate1RM();
    }

    function setReps(r) {
        document.getElementById('inp-reps').value = r;
        calculate1RM();
    }

    function calculate1RM() {
        const weight = parseFloat(document.getElementById('inp-weight').value) || 80;
        const reps = parseFloat(document.getElementById('inp-reps').value) || 5;

        // Epley Formula
        const oneRm = reps === 1 ? weight : weight * (1 + (reps / 30));
        const p90 = oneRm * 0.90;
        const p80 = oneRm * 0.80;
        const p70 = oneRm * 0.70;
        const p60 = oneRm * 0.60;

        const u = currentUnit === 'metric' ? 'kg' : 'lbs';

        document.getElementById('one-rm-val').innerText = `${oneRm.toFixed(1)} ${u}`;
        document.getElementById('pct-90-val').innerText = `${p90.toFixed(1)} ${u}`;
        document.getElementById('pct-80-val').innerText = `${p80.toFixed(1)} ${u}`;
        document.getElementById('pct-70-val').innerText = `${p70.toFixed(1)} ${u}`;
        document.getElementById('pct-60-val').innerText = `${p60.toFixed(1)} ${u}`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('oneRmChart');
            if (ctx) {
                if (oneRmChart) oneRmChart.destroy();
                oneRmChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['100% 1RM', '90%', '80%', '70%', '60%', '50%'],
                        datasets: [{
                            data: [oneRm, p90, p80, p70, p60, oneRm * 0.50],
                            backgroundColor: ['#10b981', '#0284c7', '#6366f1', '#8b5cf6', '#f59e0b', '#64748b'],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: false, grid: { color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculate1RM);
</script>

<%- include('partials/inner_footer') %>
