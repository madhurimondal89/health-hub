<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#body-composition">Body Composition</a> <span>›</span>
                <span>Body Fat Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">📐</div>
                <div class="calc-hero-text">
                    <h1>Body Fat Percentage Calculator (U.S. Navy Method)</h1>
                    <p>Calculate body fat percentage, lean mass vs fat mass in kg/lbs, and fitness category using circumference measurements.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>📏</span> Circumference Measurements
                </div>

                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (cm, kg)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (in, lbs)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" id="lbl-height">Height</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-height" class="calc-input has-suffix" value="175" min="50" max="250" oninput="calculateBodyFat()">
                        <span class="input-symbol-suffix" id="unit-height">cm</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" id="lbl-weight">Weight</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-weight" class="calc-input has-suffix" value="75" min="20" max="250" oninput="calculateBodyFat()">
                        <span class="input-symbol-suffix" id="unit-weight">kg</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Neck Circumference (at Adam's apple)</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-neck" class="calc-input has-suffix" value="38" min="20" max="80" step="0.5" oninput="calculateBodyFat()">
                        <span class="input-symbol-suffix" id="unit-neck">cm</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Waist Circumference (at navel)</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-waist" class="calc-input has-suffix" value="82" min="40" max="180" step="0.5" oninput="calculateBodyFat()">
                        <span class="input-symbol-suffix" id="unit-waist">cm</span>
                    </div>
                </div>

                <div class="form-group" id="hip-group" style="display:none;">
                    <label class="form-label">Hip Circumference (at widest point)</label>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-hip" class="calc-input has-suffix" value="95" min="40" max="180" step="0.5" oninput="calculateBodyFat()">
                        <span class="input-symbol-suffix" id="unit-hip">cm</span>
                    </div>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Estimated Body Fat Percentage</div>
                    <div class="result-main-val" id="bf-val">15.4%</div>
                    <div style="margin-top:0.5rem;">
                        <span id="bf-badge" class="card-category-tag" style="background:#10b981; color:#ffffff; font-size:0.9rem; padding:0.35rem 1rem;">
                            Fitness / Athletic Range
                        </span>
                    </div>
                </div>

                <div class="gauge-container">
                    <div class="gauge-bar">
                        <div class="gauge-needle" id="bf-needle" style="left: 35%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span style="color:#0284c7;">Essential (6-13%)</span>
                        <span style="color:#10b981;">Fitness (14-17%)</span>
                        <span style="color:#f59e0b;">Average (18-24%)</span>
                        <span style="color:#f43f5e;">Obese (25%+)</span>
                    </div>
                </div>

                <div class="result-metric-grid" style="margin-top:1rem;">
                    <div class="metric-item">
                        <div class="metric-item-label">Fat Mass</div>
                        <div class="metric-item-val" style="color:var(--accent-amber);" id="fat-mass-val">11.6 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Lean Body Mass (LBM)</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="lean-mass-val">63.4 kg</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="bfChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>ACE Body Fat Percentage Categories</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Classification</th>
                            <th>Men Range</th>
                            <th>Women Range</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Essential Fat</td>
                            <td>2% – 5%</td>
                            <td>10% – 13%</td>
                        </tr>
                        <tr style="background:var(--primary-light);">
                            <td>Athletes</td>
                            <td>6% – 13%</td>
                            <td>14% – 20%</td>
                        </tr>
                        <tr>
                            <td>Fitness</td>
                            <td>14% – 17%</td>
                            <td>21% – 24%</td>
                        </tr>
                        <tr>
                            <td>Acceptable</td>
                            <td>18% – 24%</td>
                            <td>25% – 31%</td>
                        </tr>
                        <tr>
                            <td>Obese</td>
                            <td>25%+</td>
                            <td>32%+</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let bfChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');

        const isMetric = unit === 'metric';
        document.getElementById('unit-height').innerText = isMetric ? 'cm' : 'in';
        document.getElementById('unit-weight').innerText = isMetric ? 'kg' : 'lbs';
        document.getElementById('unit-neck').innerText = isMetric ? 'cm' : 'in';
        document.getElementById('unit-waist').innerText = isMetric ? 'cm' : 'in';
        document.getElementById('unit-hip').innerText = isMetric ? 'cm' : 'in';

        if (isMetric) {
            document.getElementById('inp-height').value = 175;
            document.getElementById('inp-weight').value = 75;
            document.getElementById('inp-neck').value = 38;
            document.getElementById('inp-waist').value = 82;
            document.getElementById('inp-hip').value = 95;
        } else {
            document.getElementById('inp-height').value = 69;
            document.getElementById('inp-weight').value = 165;
            document.getElementById('inp-neck').value = 15;
            document.getElementById('inp-waist').value = 32.5;
            document.getElementById('inp-hip').value = 37.5;
        }
        calculateBodyFat();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        document.getElementById('hip-group').style.display = g === 'female' ? 'block' : 'none';
        calculateBodyFat();
    }

    function calculateBodyFat() {
        let height = parseFloat(document.getElementById('inp-height').value) || 175;
        let weight = parseFloat(document.getElementById('inp-weight').value) || 75;
        let neck = parseFloat(document.getElementById('inp-neck').value) || 38;
        let waist = parseFloat(document.getElementById('inp-waist').value) || 82;
        let hip = parseFloat(document.getElementById('inp-hip').value) || 95;

        // Convert to cm & kg for internal Navy equation
        if (currentUnit === 'imperial') {
            height = height * 2.54;
            weight = weight * 0.45359237;
            neck = neck * 2.54;
            waist = waist * 2.54;
            hip = hip * 2.54;
        }

        let bfPct = 0;
        if (gender === 'male') {
            const diff = waist - neck;
            if (diff > 0) {
                bfPct = 495 / (1.0324 - (0.19077 * Math.log10(diff)) + (0.15456 * Math.log10(height))) - 450;
            }
        } else {
            const diff = waist + hip - neck;
            if (diff > 0) {
                bfPct = 495 / (1.29579 - (0.35004 * Math.log10(diff)) + (0.22100 * Math.log10(height))) - 450;
            }
        }

        bfPct = Math.max(3, Math.min(60, bfPct));
        const fatMassKg = (weight * bfPct) / 100;
        const leanMassKg = weight - fatMassKg;

        const fatDisplay = currentUnit === 'metric' ? `${fatMassKg.toFixed(1)} kg` : `${(fatMassKg * 2.20462).toFixed(1)} lbs`;
        const leanDisplay = currentUnit === 'metric' ? `${leanMassKg.toFixed(1)} kg` : `${(leanMassKg * 2.20462).toFixed(1)} lbs`;

        let category = 'Fitness Range';
        let badgeColor = '#10b981';
        let needlePct = 40;

        if (gender === 'male') {
            if (bfPct < 6) { category = 'Essential Fat'; badgeColor = '#0284c7'; needlePct = 15; }
            else if (bfPct < 14) { category = 'Athletic'; badgeColor = '#10b981'; needlePct = 30; }
            else if (bfPct < 18) { category = 'Fitness'; badgeColor = '#10b981'; needlePct = 50; }
            else if (bfPct < 25) { category = 'Average'; badgeColor = '#f59e0b'; needlePct = 70; }
            else { category = 'Obese'; badgeColor = '#f43f5e'; needlePct = 90; }
        } else {
            if (bfPct < 14) { category = 'Essential Fat'; badgeColor = '#0284c7'; needlePct = 15; }
            else if (bfPct < 21) { category = 'Athletic'; badgeColor = '#10b981'; needlePct = 30; }
            else if (bfPct < 25) { category = 'Fitness'; badgeColor = '#10b981'; needlePct = 50; }
            else if (bfPct < 32) { category = 'Average'; badgeColor = '#f59e0b'; needlePct = 70; }
            else { category = 'Obese'; badgeColor = '#f43f5e'; needlePct = 90; }
        }

        document.getElementById('bf-val').innerText = `${bfPct.toFixed(1)}%`;
        const badge = document.getElementById('bf-badge');
        badge.innerText = category;
        badge.style.background = badgeColor;
        document.getElementById('bf-needle').style.left = `${needlePct}%`;

        document.getElementById('fat-mass-val').innerText = fatDisplay;
        document.getElementById('lean-mass-val').innerText = leanDisplay;

        // Render Chart.js
        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('bfChart');
            if (ctx) {
                if (bfChart) bfChart.destroy();
                bfChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Lean Mass (${(100 - bfPct).toFixed(1)}%)`, `Body Fat (${bfPct.toFixed(1)}%)`],
                        datasets: [{
                            data: [parseFloat((100 - bfPct).toFixed(1)), parseFloat(bfPct.toFixed(1))],
                            backgroundColor: ['#10b981', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', size: 12 } } }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateBodyFat);
</script>

<%- include('partials/inner_footer') %>