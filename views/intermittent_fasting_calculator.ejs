<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#diet-nutrition">Diet &amp; Nutrition</a> <span>›</span>
                <span>Intermittent Fasting Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">⏳</div>
                <div class="calc-hero-text">
                    <h1>Intermittent Fasting (IF) Schedule &amp; Window Calculator</h1>
                    <p>Calculate your daily fasting and eating windows for 16:8, 18:6, 20:4 (Warrior Diet), and 23:1 (OMAD) protocols with cellular autophagy timeline.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>⏳</span> Fasting Protocol
                </div>

                <div class="form-group">
                    <label class="form-label">Fasting Method</label>
                    <select id="inp-if-protocol" class="calc-input" onchange="calculateIF()">
                        <option value="16:8" selected>16:8 Leangains (16h Fast / 8h Eating Window) [Most Popular]</option>
                        <option value="18:6">18:6 Accelerated (18h Fast / 6h Eating Window)</option>
                        <option value="20:4">20:4 Warrior Diet (20h Fast / 4h Eating Window)</option>
                        <option value="23:1">23:1 OMAD (One Meal A Day - 23h Fast / 1h Feast)</option>
                        <option value="14:10">14:10 Gentle Starter (14h Fast / 10h Eating)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-first-meal">First Meal (Break-Fast) Time</label>
                    <input type="time" id="inp-first-meal" class="calc-input" value="12:00" onchange="calculateIF()">
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Daily Eating Window</div>
                    <div class="result-main-val" id="eating-window-val" style="font-size:2.2rem;">12:00 PM – 8:00 PM</div>
                    <div style="margin-top:0.5rem;">
                        <span class="card-category-tag" style="background:#10b981; color:#ffffff; font-size:0.92rem; padding:0.35rem 1.15rem;">
                            16 Hours Fasting / 8 Hours Eating
                        </span>
                    </div>
                </div>

                <div class="result-metric-grid">
                    <div class="metric-item">
                        <div class="metric-item-label">Fasting Starts (Post Last Meal)</div>
                        <div class="metric-item-val" style="color:var(--accent-amber);" id="fast-start-val">8:00 PM</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Ketosis &amp; Fat Burn Activation</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="ketosis-start-val">8:00 AM (Hour 12)</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Autophagy Cellular Cleanse</div>
                        <div class="metric-item-val" id="autophagy-val">10:00 AM (Hour 14)</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Fast Breaks (Next Day)</div>
                        <div class="metric-item-val" id="fast-break-val">12:00 PM</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="ifChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>The Biological Stages of Intermittent Fasting</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Hours of Fast</th>
                            <th>Metabolic Stage</th>
                            <th>Cellular Effect</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>0 – 4 Hours</td>
                            <td>Anabolic / Fed State</td>
                            <td>Insulin rises, glucose used for energy</td>
                        </tr>
                        <tr>
                            <td>4 – 12 Hours</td>
                            <td>Post-Absorptive State</td>
                            <td>Blood glucose normalizes, glycogen breakdown begins</td>
                        </tr>
                        <tr style="background:var(--primary-light);">
                            <td>12 – 16 Hours</td>
                            <td>Fat Burning &amp; Ketosis</td>
                            <td>Liver glycogen depletes, adipose fat converted to ketones</td>
                        </tr>
                        <tr>
                            <td>16 – 24 Hours</td>
                            <td>Autophagy Cleanse</td>
                            <td>Cellular recycling of damaged organelles and proteins</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let ifChart = null;

    function formatTime(d) {
        let hours = d.getHours();
        let minutes = d.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        return `${hours}:${minutes} ${ampm}`;
    }

    function calculateIF() {
        const protocol = document.getElementById('inp-if-protocol').value;
        const [fastH, eatH] = protocol.split(':').map(Number);
        const timeStr = document.getElementById('inp-first-meal').value || '12:00';
        const [h, m] = timeStr.split(':').map(Number);

        const firstMeal = new Date();
        firstMeal.setHours(h, m, 0, 0);

        const lastMeal = new Date(firstMeal.getTime() + (eatH * 60 * 60 * 1000));
        const ketosisTime = new Date(lastMeal.getTime() + (12 * 60 * 60 * 1000));
        const autoTime = new Date(lastMeal.getTime() + (14 * 60 * 60 * 1000));

        document.getElementById('eating-window-val').innerText = `${formatTime(firstMeal)} – ${formatTime(lastMeal)}`;
        document.getElementById('fast-start-val').innerText = formatTime(lastMeal);
        document.getElementById('ketosis-start-val').innerText = `${formatTime(ketosisTime)} (+12h)`;
        document.getElementById('autophagy-val').innerText = `${formatTime(autoTime)} (+14h)`;
        document.getElementById('fast-break-val').innerText = formatTime(firstMeal);

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('ifChart');
            if (ctx) {
                if (ifChart) ifChart.destroy();
                ifChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`Fasting Window (${fastH} hrs)`, `Eating Window (${eatH} hrs)`],
                        datasets: [{
                            data: [fastH, eatH],
                            backgroundColor: ['#0284c7', '#10b981'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateIF);
</script>

<%- include('partials/inner_footer') %>
