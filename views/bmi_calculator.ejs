<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#body-composition">Body Composition</a> <span>›</span>
                <span>BMI Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">⚖️</div>
                <div class="calc-hero-text">
                    <h1>BMI Calculator (Body Mass Index)</h1>
                    <p>Calculate your Body Mass Index (BMI), healthy weight range, and prime health category with clinical accuracy.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <!-- Left: Inputs -->
            <div class="input-card">
                <div class="section-subtitle">
                    <span>⚙️</span> Body Measurements
                </div>

                <!-- Unit Switcher -->
                <div class="form-group">
                    <label class="form-label">Measurement System</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="unit-metric" class="toggle-pill-btn active" style="flex:1;" onclick="switchUnit('metric')">📏 Metric (kg, cm)</button>
                        <button type="button" id="unit-imperial" class="toggle-pill-btn" style="flex:1;" onclick="switchUnit('imperial')">📐 Imperial (lbs, ft-in)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label" for="inp-age">Age</label>
                        <span class="chip" onclick="setAge(25)">25 Yrs</span>
                    </div>
                    <div class="input-with-symbol">
                        <input type="number" id="inp-age" class="calc-input has-suffix" value="28" min="2" max="110" oninput="syncSlider('inp-age'); calculateBMI();">
                        <span class="input-symbol-suffix">Yrs</span>
                    </div>
                    <div class="range-slider-wrap">
                        <input type="range" id="inp-age-slider" class="calc-slider" value="28" min="2" max="100" oninput="syncInput('inp-age'); calculateBMI();">
                    </div>
                </div>

                <!-- Metric Inputs -->
                <div id="metric-inputs">
                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="inp-height-cm">Height (cm)</label>
                            <div class="preset-chips">
                                <span class="chip" onclick="setHeightCm(160)">160 cm</span>
                                <span class="chip" onclick="setHeightCm(170)">170 cm</span>
                                <span class="chip" onclick="setHeightCm(175)">175 cm</span>
                                <span class="chip" onclick="setHeightCm(180)">180 cm</span>
                            </div>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-height-cm" class="calc-input has-suffix" value="175" min="50" max="250" step="0.5" oninput="syncSlider('inp-height-cm'); calculateBMI();">
                            <span class="input-symbol-suffix">cm</span>
                        </div>
                        <div class="range-slider-wrap">
                            <input type="range" id="inp-height-cm-slider" class="calc-slider" value="175" min="100" max="220" step="0.5" oninput="syncInput('inp-height-cm'); calculateBMI();">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="inp-weight-kg">Weight (kg)</label>
                            <div class="preset-chips">
                                <span class="chip" onclick="setWeightKg(60)">60 kg</span>
                                <span class="chip" onclick="setWeightKg(70)">70 kg</span>
                                <span class="chip" onclick="setWeightKg(80)">80 kg</span>
                            </div>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-kg" class="calc-input has-suffix" value="70" min="20" max="250" step="0.5" oninput="syncSlider('inp-weight-kg'); calculateBMI();">
                            <span class="input-symbol-suffix">kg</span>
                        </div>
                        <div class="range-slider-wrap">
                            <input type="range" id="inp-weight-kg-slider" class="calc-slider" value="70" min="30" max="160" step="0.5" oninput="syncInput('inp-weight-kg'); calculateBMI();">
                        </div>
                    </div>
                </div>

                <!-- Imperial Inputs -->
                <div id="imperial-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Height (Feet &amp; Inches)</label>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                            <div class="input-with-symbol">
                                <input type="number" id="inp-height-ft" class="calc-input has-suffix" value="5" min="1" max="8" oninput="calculateBMI()">
                                <span class="input-symbol-suffix">ft</span>
                            </div>
                            <div class="input-with-symbol">
                                <input type="number" id="inp-height-in" class="calc-input has-suffix" value="9" min="0" max="11" oninput="calculateBMI()">
                                <span class="input-symbol-suffix">in</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="inp-weight-lbs">Weight (lbs)</label>
                        </div>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-weight-lbs" class="calc-input has-suffix" value="154" min="40" max="500" step="1" oninput="calculateBMI()">
                            <span class="input-symbol-suffix">lbs</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Results & Interactive Gauge -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Your Body Mass Index (BMI)</div>
                    <div class="result-main-val" id="bmi-val">22.9</div>
                    <div style="margin-top:0.5rem;">
                        <span id="bmi-badge" class="card-category-tag" style="background:#10b981; color:#ffffff; font-size:0.9rem; padding:0.35rem 1rem;">
                            Healthy Weight
                        </span>
                    </div>
                </div>

                <!-- Visual Speedometer / Range Gauge -->
                <div class="gauge-container">
                    <div class="gauge-bar">
                        <div class="gauge-needle" id="gauge-needle" style="left: 45%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span style="color:#0284c7;">Underweight (&lt;18.5)</span>
                        <span style="color:#10b981;">Normal (18.5-24.9)</span>
                        <span style="color:#f59e0b;">Overweight (25-29.9)</span>
                        <span style="color:#f43f5e;">Obese (30+)</span>
                    </div>
                </div>

                <!-- Metrics Grid -->
                <div class="result-metric-grid" style="margin-top:1rem;">
                    <div class="metric-item">
                        <div class="metric-item-label">Healthy Weight Range</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="healthy-weight-range">56.7 – 76.3 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Ideal Body Weight (Devine)</div>
                        <div class="metric-item-val" id="ideal-weight-val">70.7 kg</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">BMI Prime</div>
                        <div class="metric-item-val" id="bmi-prime-val">0.91</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Ponderal Index</div>
                        <div class="metric-item-val" id="ponderal-val">13.1 kg/m³</div>
                    </div>
                </div>

                <!-- Interactive Chart -->
                <div class="chart-box">
                    <canvas id="bmiChart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <!-- Clinical Classification Table -->
        <div class="info-section">
            <h2>WHO &amp; CDC Body Mass Index (BMI) Classifications</h2>
            <div class="table-responsive" style="margin-top:1rem;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>BMI Category</th>
                            <th>BMI Range (kg/m²)</th>
                            <th>Health Risk Level</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span style="color:#0284c7; font-weight:700;">● Underweight</span></td>
                            <td>&lt; 18.5</td>
                            <td>Increased risk of nutritional deficiency &amp; osteoporosis</td>
                        </tr>
                        <tr style="background:var(--primary-light);">
                            <td><span style="color:#10b981; font-weight:700;">● Normal / Healthy Weight</span></td>
                            <td>18.5 – 24.9</td>
                            <td>Lowest cardiovascular and metabolic risk</td>
                        </tr>
                        <tr>
                            <td><span style="color:#f59e0b; font-weight:700;">● Overweight</span></td>
                            <td>25.0 – 29.9</td>
                            <td>Moderate risk of heart disease, hypertension &amp; diabetes</td>
                        </tr>
                        <tr>
                            <td><span style="color:#f43f5e; font-weight:700;">● Obese Class I</span></td>
                            <td>30.0 – 34.9</td>
                            <td>High risk of metabolic syndrome</td>
                        </tr>
                        <tr>
                            <td><span style="color:#dc2626; font-weight:700;">● Obese Class II / III</span></td>
                            <td>35.0 &amp; Above</td>
                            <td>Very high clinical risk</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FAQ Section -->
        <section class="info-section">
            <h2>Frequently Asked Questions About BMI</h2>
            <div class="faq-list">
                <div class="faq-item open">
                    <button class="faq-question" onclick="toggleFaq(this)">
                        <span>How is Body Mass Index (BMI) calculated?</span>
                        <span>▼</span>
                    </button>
                    <div class="faq-answer">
                        <p>BMI is calculated by dividing your body weight in kilograms by your height in meters squared: <code>BMI = weight(kg) / [height(m)]²</code>. For imperial measurements: <code>BMI = 703 × weight(lbs) / [height(in)]²</code>.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" onclick="toggleFaq(this)">
                        <span>Is BMI accurate for muscular athletes and bodybuilders?</span>
                        <span>▼</span>
                    </button>
                    <div class="faq-answer">
                        <p>BMI does not directly differentiate between muscle and fat mass. Athletes with high muscle mass may have a high BMI despite having low body fat. In such cases, use our <strong>Body Fat Calculator</strong> or <strong>FFMI Calculator</strong>.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let currentUnit = 'metric';
    let gender = 'male';
    let bmiChart = null;

    function switchUnit(unit) {
        currentUnit = unit;
        document.getElementById('unit-metric').classList.toggle('active', unit === 'metric');
        document.getElementById('unit-imperial').classList.toggle('active', unit === 'imperial');
        document.getElementById('metric-inputs').style.display = unit === 'metric' ? 'block' : 'none';
        document.getElementById('imperial-inputs').style.display = unit === 'imperial' ? 'block' : 'none';
        calculateBMI();
    }

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateBMI();
    }

    function setAge(a) {
        document.getElementById('inp-age').value = a;
        document.getElementById('inp-age-slider').value = a;
        calculateBMI();
    }

    function setHeightCm(h) {
        document.getElementById('inp-height-cm').value = h;
        document.getElementById('inp-height-cm-slider').value = h;
        calculateBMI();
    }

    function setWeightKg(w) {
        document.getElementById('inp-weight-kg').value = w;
        document.getElementById('inp-weight-kg-slider').value = w;
        calculateBMI();
    }

    function syncSlider(id) {
        document.getElementById(id + '-slider').value = document.getElementById(id).value;
    }

    function syncInput(id) {
        document.getElementById(id).value = document.getElementById(id + '-slider').value;
    }

    function toggleFaq(btn) {
        btn.parentElement.classList.toggle('open');
    }

    function calculateBMI() {
        let weightKg, heightCm;

        if (currentUnit === 'metric') {
            weightKg = parseFloat(document.getElementById('inp-weight-kg').value) || 70;
            heightCm = parseFloat(document.getElementById('inp-height-cm').value) || 175;
        } else {
            const lbs = parseFloat(document.getElementById('inp-weight-lbs').value) || 154;
            const ft = parseFloat(document.getElementById('inp-height-ft').value) || 5;
            const inches = parseFloat(document.getElementById('inp-height-in').value) || 9;
            weightKg = lbs * 0.45359237;
            heightCm = (ft * 12 + inches) * 2.54;
        }

        const heightM = heightCm / 100;
        const bmi = weightKg / (heightM * heightM);
        const bmiPrime = bmi / 25;
        const ponderalIndex = weightKg / (heightM * heightM * heightM);

        // Healthy Weight Range (18.5 - 24.9)
        const minHealthyKg = 18.5 * (heightM * heightM);
        const maxHealthyKg = 24.9 * (heightM * heightM);

        // Devine Ideal Weight
        const inchesOver5Ft = Math.max(0, (heightCm / 2.54) - 60);
        const devineKg = gender === 'male' ? 50 + (2.3 * inchesOver5Ft) : 45.5 + (2.3 * inchesOver5Ft);

        // Category Classification & Needle Percentage
        let category = 'Normal Weight';
        let badgeColor = '#10b981';
        let needlePct = 50;

        if (bmi < 18.5) {
            category = 'Underweight';
            badgeColor = '#0284c7';
            needlePct = Math.max(5, (bmi / 18.5) * 25);
        } else if (bmi < 25) {
            category = 'Healthy Weight';
            badgeColor = '#10b981';
            needlePct = 25 + ((bmi - 18.5) / 6.5) * 35;
        } else if (bmi < 30) {
            category = 'Overweight';
            badgeColor = '#f59e0b';
            needlePct = 60 + ((bmi - 25) / 5) * 25;
        } else {
            category = 'Obesity';
            badgeColor = '#f43f5e';
            needlePct = Math.min(95, 85 + ((bmi - 30) / 10) * 10);
        }

        // Render Values
        document.getElementById('bmi-val').innerText = bmi.toFixed(1);
        const badge = document.getElementById('bmi-badge');
        badge.innerText = category;
        badge.style.background = badgeColor;
        document.getElementById('gauge-needle').style.left = `${needlePct}%`;

        document.getElementById('healthy-weight-range').innerText = `${minHealthyKg.toFixed(1)} – ${maxHealthyKg.toFixed(1)} kg`;
        document.getElementById('ideal-weight-val').innerText = `${devineKg.toFixed(1)} kg`;
        document.getElementById('bmi-prime-val').innerText = bmiPrime.toFixed(2);
        document.getElementById('ponderal-val').innerText = `${ponderalIndex.toFixed(1)} kg/m³`;

        // Render Chart.js
        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('bmiChart');
            if (ctx) {
                if (bmiChart) bmiChart.destroy();
                bmiChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Your BMI', 'Max Normal (25)'],
                        datasets: [{
                            data: [parseFloat(bmi.toFixed(1)), Math.max(0, parseFloat((25 - Math.min(bmi, 25)).toFixed(1)))],
                            backgroundColor: [badgeColor, document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#e2e8f0'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateBMI);
</script>

<%- include('partials/inner_footer') %>