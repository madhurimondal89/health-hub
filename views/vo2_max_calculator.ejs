<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#fitness-workouts">Fitness &amp; Workouts</a> <span>›</span>
                <span>VO2 Max Calculator</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🫁</div>
                <div class="calc-hero-text">
                    <h1>VO2 Max &amp; Aerobic Fitness Calculator</h1>
                    <p>Calculate your maximal oxygen uptake capacity (ml/kg/min) and cardiovascular fitness percentile using Cooper Run or Resting Heart Rate methods.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="calc-workspace">
            <div class="input-card">
                <div class="section-subtitle">
                    <span>🏃</span> Assessment Method
                </div>

                <div class="form-group">
                    <label class="form-label">Testing Protocol</label>
                    <select id="inp-method" class="calc-input" onchange="switchMethod()">
                        <option value="cooper" selected>Cooper 12-Minute Run Test</option>
                        <option value="resting-hr">Uth–Sørensen–Overgaard–Pedersen (Resting HR)</option>
                        <option value="rockport">Rockport 1-Mile Walk Test</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Biological Gender</label>
                    <div class="toggle-pills" style="width:100%; display:flex;">
                        <button type="button" id="btn-male" class="toggle-pill-btn active" style="flex:1;" onclick="setGender('male')">👨 Male</button>
                        <button type="button" id="btn-female" class="toggle-pill-btn" style="flex:1;" onclick="setGender('female')">👩 Female</button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-age">Age</label>
                    <input type="number" id="inp-age" class="calc-input" value="28" min="15" max="90" oninput="calculateVO2()">
                </div>

                <div id="cooper-inputs">
                    <div class="form-group">
                        <label class="form-label" for="inp-distance">Distance Covered in 12 Minutes (meters)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-distance" class="calc-input has-suffix" value="2400" min="500" max="5000" step="50" oninput="calculateVO2()">
                            <span class="input-symbol-suffix">meters</span>
                        </div>
                    </div>
                </div>

                <div id="resting-hr-inputs" style="display:none;">
                    <div class="form-group">
                        <label class="form-label" for="inp-rhr">Resting Heart Rate (BPM)</label>
                        <div class="input-with-symbol">
                            <input type="number" id="inp-rhr" class="calc-input has-suffix" value="62" min="35" max="120" oninput="calculateVO2()">
                            <span class="input-symbol-suffix">BPM</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Results -->
            <div class="results-card">
                <div class="result-main-banner">
                    <div class="result-main-label">Estimated VO2 Max</div>
                    <div class="result-main-val" id="vo2-val">42.4 ml/kg/min</div>
                    <div style="margin-top:0.5rem;">
                        <span id="vo2-badge" class="card-category-tag" style="background:#10b981; color:#ffffff; font-size:0.92rem; padding:0.35rem 1.15rem;">
                            Good / Above Average
                        </span>
                    </div>
                </div>

                <div class="gauge-container">
                    <div class="gauge-bar">
                        <div class="gauge-needle" id="vo2-needle" style="left: 65%;"></div>
                    </div>
                    <div class="gauge-labels">
                        <span style="color:#f43f5e;">Poor (&lt;30)</span>
                        <span style="color:#f59e0b;">Fair (30-37)</span>
                        <span style="color:#10b981;">Good (38-48)</span>
                        <span style="color:#0284c7;">Superior (49+)</span>
                    </div>
                </div>

                <div class="result-metric-grid" style="margin-top:1rem;">
                    <div class="metric-item">
                        <div class="metric-item-label">Fitness Category</div>
                        <div class="metric-item-val" style="color:var(--primary);" id="fitness-cat-val">Above Average</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-item-label">Cardiovascular Age</div>
                        <div class="metric-item-val" id="cardio-age-val">24 Yrs</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="vo2Chart"></canvas>
                </div>
            </div>
        </div>

        <%- include('partials/ad_unit') %>

        <section class="info-section">
            <h2>Cardiovascular Health &amp; VO2 Max</h2>
            <p>
                <strong>VO2 Max</strong> is the single strongest clinical biomarker for cardiorespiratory fitness and long-term cardiovascular longevity.
            </p>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let gender = 'male';
    let vo2Chart = null;

    function setGender(g) {
        gender = g;
        document.getElementById('btn-male').classList.toggle('active', g === 'male');
        document.getElementById('btn-female').classList.toggle('active', g === 'female');
        calculateVO2();
    }

    function switchMethod() {
        const method = document.getElementById('inp-method').value;
        document.getElementById('cooper-inputs').style.display = method === 'cooper' ? 'block' : 'none';
        document.getElementById('resting-hr-inputs').style.display = method === 'resting-hr' ? 'block' : 'none';
        calculateVO2();
    }

    function calculateVO2() {
        const method = document.getElementById('inp-method').value;
        const age = parseFloat(document.getElementById('inp-age').value) || 28;

        let vo2 = 0;
        if (method === 'cooper') {
            const dist = parseFloat(document.getElementById('inp-distance').value) || 2400;
            // Cooper equation: (distance in meters - 504.9) / 44.73
            vo2 = (dist - 504.9) / 44.73;
        } else {
            const rhr = parseFloat(document.getElementById('inp-rhr').value) || 62;
            const maxHr = 220 - age;
            // Uth formula: 15.3 * (HRmax / HRrest)
            vo2 = 15.3 * (maxHr / rhr);
        }

        vo2 = Math.max(15, Math.min(85, vo2));

        let category = 'Good';
        let badgeColor = '#10b981';
        let needlePct = 60;

        if (vo2 < 30) { category = 'Poor'; badgeColor = '#f43f5e'; needlePct = 20; }
        else if (vo2 < 38) { category = 'Fair'; badgeColor = '#f59e0b'; needlePct = 40; }
        else if (vo2 < 48) { category = 'Good'; badgeColor = '#10b981'; needlePct = 65; }
        else { category = 'Superior'; badgeColor = '#0284c7'; needlePct = 90; }

        document.getElementById('vo2-val').innerText = `${vo2.toFixed(1)} ml/kg/min`;
        const badge = document.getElementById('vo2-badge');
        badge.innerText = category;
        badge.style.background = badgeColor;
        document.getElementById('vo2-needle').style.left = `${needlePct}%`;
        document.getElementById('fitness-cat-val').innerText = category;
        document.getElementById('cardio-age-val').innerText = `${Math.max(18, Math.round(age - (vo2 - 40) * 0.5))} Yrs`;

        if (typeof Chart !== 'undefined') {
            const ctx = document.getElementById('vo2Chart');
            if (ctx) {
                if (vo2Chart) vo2Chart.destroy();
                vo2Chart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [`VO2 Max (${vo2.toFixed(1)})`, 'Elite Standard (60)'],
                        datasets: [{
                            data: [vo2, Math.max(0, 60 - vo2)],
                            backgroundColor: [badgeColor, document.documentElement.getAttribute('data-theme') === 'dark' ? '#1f293d' : '#e2e8f0'],
                            borderWidth: 2,
                            borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', calculateVO2);
</script>

<%- include('partials/inner_footer') %>
