<%- include('partials/inner_header') %>

<main>
    <section class="calc-page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/">Home</a> <span>›</span>
                <a href="/#fitness-workouts">Fitness &amp; Workouts</a> <span>›</span>
                <span>Workout &amp; Exercise Explorer</span>
            </div>
            <div class="calc-hero-content">
                <div class="calc-hero-icon">🏋️‍♂️</div>
                <div class="calc-hero-text">
                    <h1>Live Workout &amp; Muscle Exercise Explorer</h1>
                    <p>Filter exercises by target muscle anatomy (Chest, Legs, Back, Shoulders, Arms, Core, Cardio) with real-time MET calorie burn calculations based on your body weight.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <!-- Muscle Category Filter Pills -->
        <div class="category-filter-wrap" style="margin-bottom: 2rem;">
            <button class="filter-btn active" data-muscle="all" onclick="filterMuscle('all', this)">🌟 All Exercises</button>
            <button class="filter-btn" data-muscle="chest" onclick="filterMuscle('chest', this)">🛡️ Chest</button>
            <button class="filter-btn" data-muscle="legs" onclick="filterMuscle('legs', this)">🦵 Legs &amp; Glutes</button>
            <button class="filter-btn" data-muscle="back" onclick="filterMuscle('back', this)">🦅 Back &amp; Lats</button>
            <button class="filter-btn" data-muscle="shoulders" onclick="filterMuscle('shoulders', this)">🎯 Shoulders</button>
            <button class="filter-btn" data-muscle="arms" onclick="filterMuscle('arms', this)">💪 Arms (Biceps/Triceps)</button>
            <button class="filter-btn" data-muscle="core" onclick="filterMuscle('core', this)">🧱 Core &amp; Abs</button>
            <button class="filter-btn" data-muscle="cardio" onclick="filterMuscle('cardio', this)">🫀 Cardio &amp; HIIT</button>
        </div>

        <!-- Weight Parameter for Calorie Burn -->
        <div class="input-card" style="margin-bottom: 2.25rem;">
            <div class="form-label-row">
                <label class="form-label" for="inp-user-weight">Your Body Weight (Used for real-time calorie burn calculation)</label>
            </div>
            <div class="input-with-symbol" style="max-width: 320px;">
                <input type="number" id="inp-user-weight" class="calc-input has-suffix" value="75" min="30" max="200" oninput="renderExercises()">
                <span class="input-symbol-suffix">kg</span>
            </div>
        </div>

        <!-- Exercise Cards Grid -->
        <div class="calc-grid" id="exercise-grid">
            <!-- Populated via JS -->
        </div>

        <%- include('partials/ad_unit') %>
    </div>
</main>

<script>
    let currentMuscle = 'all';
    let allExercises = [];

    async function loadExercises() {
        try {
            const res = await fetch('/api/exercises');
            const data = await res.json();
            if (data.success) {
                allExercises = data.exercises;
                renderExercises();
            }
        } catch (err) {
            console.error(err);
        }
    }

    function filterMuscle(muscle, btn) {
        currentMuscle = muscle;
        document.querySelectorAll('.category-filter-wrap .filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderExercises();
    }

    function renderExercises() {
        const grid = document.getElementById('exercise-grid');
        grid.innerHTML = '';
        const weightKg = parseFloat(document.getElementById('inp-user-weight').value) || 75;

        let filtered = allExercises;
        if (currentMuscle !== 'all') {
            filtered = allExercises.filter(e => e.muscle.toLowerCase() === currentMuscle.toLowerCase());
        }

        filtered.forEach(ex => {
            // Calorie burn = MET * 3.5 * weightKg / 200 (per minute)
            const calPerMin = (ex.met * 3.5 * weightKg / 200).toFixed(1);
            const cal30Min = Math.round(calPerMin * 30);

            const card = document.createElement('div');
            card.className = 'calc-card';
            card.innerHTML = `
                <div class="card-top">
                    <div class="card-icon-box">🏋️‍♂️</div>
                    <span class="card-category-tag">${ex.muscle}</span>
                </div>
                <h3>${ex.name}</h3>
                <p><strong>Secondary Targets:</strong> ${ex.secondary}<br><strong>Equipment:</strong> ${ex.equipment}</p>
                
                <div class="metric-item" style="margin: 0.75rem 0 1rem; border-color:var(--primary-border);">
                    <div class="metric-item-label">Estimated Energy Burn</div>
                    <div style="font-weight:800; color:var(--primary); font-family:var(--font-heading); font-size:1.15rem;">
                        ${calPerMin} kcal/min <span style="font-size:0.85rem; color:var(--text-muted); font-weight:500;">(~${cal30Min} kcal in 30m)</span>
                    </div>
                </div>

                <div style="font-size:0.85rem; color:var(--text-secondary); line-height:1.45; background:var(--bg-surface-subtle); padding:0.75rem; border-radius:var(--radius-sm);">
                    💡 <strong>Form Tip:</strong> ${ex.tip}
                </div>
            `;
            grid.appendChild(card);
        });
    }

    document.addEventListener('DOMContentLoaded', loadExercises);
</script>

<%- include('partials/inner_footer') %>
