<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DSS4N95B8B"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-DSS4N95B8B');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8732458645979427" crossorigin="anonymous"></script>

    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://health-hub.calculatorfree.in/">

    <!-- Open Graph & Social -->
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="https://health-hub.calculatorfree.in/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Health Hub">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://www.calculatorfree.in/wp-content/uploads/2025/07/cropped-calculatorfree.png">
    <link rel="apple-touch-icon" href="https://www.calculatorfree.in/wp-content/uploads/2025/07/cropped-calculatorfree.png">

    <!-- CSS (Modern Sleek Dashboard Theme) -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Schema -->
    <% if (typeof schema !== 'undefined' && schema) { %>
    <script type="application/ld+json"><%- schema %></script>
    <% } %>

    <!-- Theme initialization -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('hh_theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>

    <header class="main-header">
        <div class="container header-inner">
            <a href="/" class="brand-logo">
                <div class="logo-icon">🌿</div>
                <div class="logo-text">Health<span>Hub</span></div>
            </a>

            <div class="nav-actions">
                <a href="https://financialhub.calculatorfree.in/" target="_blank" rel="noopener" class="nav-link" title="Financial Hub Calculators">
                    <span>💰</span> <span>Financial Hub</span>
                </a>
                <a href="https://engineering.calculatorfree.in/" target="_blank" rel="noopener" class="nav-link" title="Engineering Hub Calculators">
                    <span>⚙️</span> <span>Engineering Hub</span>
                </a>
                <button class="theme-toggle" id="theme-toggle" title="Toggle Theme" aria-label="Toggle Theme">
                    <span id="theme-icon">🌙</span>
                </button>
            </div>
        </div>
    </header>